<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haider Ali | Development Workflow & Engineering Process</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #050811;
            --bg-surface: rgba(15, 23, 42, 0.65);
            --bg-card: rgba(30, 41, 59, 0.7);
            --bg-card-hover: rgba(51, 65, 85, 0.85);
            
            --neon-green: #10b981;
            --neon-cyan: #06b6d4;
            --neon-purple: #a855f7;
            
            --text-white: #f8fafc;
            --text-muted: #94a3b8;
            --border-line: rgba(255, 255, 255, 0.08);
            
            --main-gradient: linear-gradient(135deg, #10b981 0%, #06b6d4 50%, #a855f7 100%);
            --glow-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; scroll-behavior: smooth; }
        h1, h2, h3, h4, .logo, .step-num, .slogan-tag { font-family: 'Space Grotesk', sans-serif; }
        
        body { 
            background-color: var(--bg-deep); 
            color: var(--text-white); 
            overflow-x: hidden; 
            line-height: 1.6;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 85% 60%, rgba(168, 85, 247, 0.08) 0%, transparent 45%),
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
            background-attachment: fixed;
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        /* --- Header Navigation --- */
        header { 
            position: sticky; 
            top: 0; 
            background: rgba(5, 8, 17, 0.85); 
            backdrop-filter: blur(20px); 
            border-bottom: 1px solid var(--border-line); 
            z-index: 1000; 
            padding: 16px 0; 
        }
        .nav-box { display: flex; justify-content: space-between; align-items: center; }
        .logo { 
            font-size: 1.6rem; 
            font-weight: 700; 
            text-decoration: none; 
            background: var(--main-gradient); 
            
            -webkit-text-fill-color: transparent; 
        }

        .nav-menu { display: flex; gap: 28px; list-style: none; align-items: center; }
        .nav-item { position: relative; }
        .nav-link { color: var(--text-muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; transition: 0.3s; }
        .nav-link:hover, .nav-link.active { color: #fff; }

        .dropdown { position: absolute; top: 120%; left: 0; background: var(--bg-card); backdrop-filter: blur(15px); border: 1px solid var(--border-line); border-radius: 12px; min-width: 200px; padding: 8px 0; opacity: 0; visibility: hidden; transform: translateY(10px); transition: all 0.3s ease; }
        .nav-item:hover .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown a { display: block; padding: 10px 20px; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; }
        .dropdown a:hover { background: var(--bg-card-hover); color: var(--neon-cyan); }

        .btn-enquiry { background: var(--main-gradient); color: #000; padding: 10px 24px; border-radius: 30px; font-weight: 700; text-decoration: none; font-size: 0.9rem; transition: 0.3s; border: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-enquiry:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(6, 182, 212, 0.45); }
        .menu-toggle { display: none; color: #fff; font-size: 1.5rem; cursor: pointer; }

        /* --- Page Header Banner --- */
        .page-header { text-align: center; padding: 60px 0 40px; }
        .slogan-tag { font-size: 0.95rem; color: var(--neon-cyan); font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px; display: block; }
        .gradient-text { background: var(--main-gradient); -webkit-text-fill-color: transparent; }
        .page-header h1 { font-size: 2.8rem; margin-bottom: 12px; }
        .page-header p { color: var(--text-muted); max-width: 650px; margin: 0 auto; font-size: 1rem; }

        /* --- ZIGZAG WORKFLOW SECTION --- */
        .workflow-section { position: relative; padding: 40px 0 90px; }
        .zigzag-wrapper { position: relative; max-width: 1050px; margin: 0 auto; display: flex; flex-direction: column; }

        /* Central Vertical Base Line */
        .zigzag-line-bg {
            position: absolute;
            top: 25px;
            bottom: 25px;
            left: 50%;
            width: 4px;
            background: rgba(255, 255, 255, 0.08);
            transform: translateX(-50%);
            border-radius: 4px;
        }

        /* Dynamic Animated Fill Progress Line */
        .zigzag-line-fill {
            position: absolute;
            top: 25px;
            left: 50%;
            width: 4px;
            height: 0%;
            background: var(--main-gradient);
            transform: translateX(-50%);
            border-radius: 4px;
            box-shadow: 0 0 15px var(--neon-cyan);
            transition: height 0.15s linear;
        }

        /* Zigzag Step Layout */
        .zigzag-item {
            position: relative;
            width: 50%;
            margin-bottom: 70px;
            display: flex;
        }

        /* Left Side Cards */
        .zigzag-item.left {
            align-self: flex-start;
            justify-content: flex-end;
            padding-right: 50px;
        }

        /* Right Side Cards */
        .zigzag-item.right {
            align-self: flex-end;
            justify-content: flex-start;
            padding-left: 50px;
        }

        /* Center Node Icon */
        .zigzag-node {
            position: absolute;
            top: 15px;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: var(--bg-deep);
            border: 2px solid var(--border-line);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 1.1rem;
            z-index: 10;
            transition: all 0.4s ease;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.9);
        }

        .zigzag-item.left .zigzag-node {
            right: -26px;
        }

        .zigzag-item.right .zigzag-node {
            left: -26px;
        }

        /* Glowing Node State */
        .zigzag-item.active .zigzag-node {
            border-color: var(--neon-cyan);
            color: #000;
            background: var(--main-gradient);
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.7);
        }

        /* Step Card Styling */
        .zigzag-card {
            width: 100%;
            background: var(--bg-surface);
            border: 1px solid var(--border-line);
            border-radius: 20px;
            padding: 32px;
            position: relative;
            backdrop-filter: blur(14px);
            transition: all 0.4s ease;
        }

        .zigzag-card:hover {
            transform: translateY(-5px);
            border-color: rgba(6, 182, 212, 0.5);
            background: var(--bg-card-hover);
        }

        .zigzag-item.active .zigzag-card {
            border-color: rgba(6, 182, 212, 0.4);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45);
        }

        /* Visual Connectors between Node & Card */
        .zigzag-card::before {
            content: '';
            position: absolute;
            top: 30px;
            width: 25px;
            height: 2px;
            background: var(--border-line);
            transition: 0.4s;
        }

        .zigzag-item.left .zigzag-card::before { right: -25px; }
        .zigzag-item.right .zigzag-card::before { left: -25px; }

        .zigzag-item.active .zigzag-card::before {
            background: var(--neon-cyan);
            box-shadow: 0 0 8px var(--neon-cyan);
        }

        /* Card Content Components */
        .card-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
        .step-num { font-size: 2.2rem; font-weight: 700; color: var(--neon-green); line-height: 1; }
        .step-badge { background: rgba(255,255,255,0.05); border: 1px solid var(--border-line); color: var(--neon-cyan); font-size: 0.75rem; padding: 4px 12px; border-radius: 20px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; }

        .zigzag-card h3 { font-size: 1.35rem; margin-bottom: 12px; color: var(--text-white); }
        .zigzag-card p { color: var(--text-muted); font-size: 0.94rem; line-height: 1.65; }

        /* Feature Tags inside Card */
        .feature-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
        .tag-pill { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: var(--neon-green); padding: 5px 12px; border-radius: 8px; font-size: 0.78rem; font-weight: 600; }

        /* --- Footer --- */
        footer { background: #020408; border-top: 1px solid var(--border-line); padding: 60px 0 25px; color: var(--text-muted); font-size: 0.9rem; margin-top: 40px; }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 40px; margin-bottom: 45px; }
        .footer-brand p { margin-top: 12px; font-size: 0.88rem; max-width: 300px; line-height: 1.6; }
        .footer-title { color: var(--text-white); font-size: 1.1rem; font-weight: 700; margin-bottom: 18px; }
        .footer-links { list-style: none; }
        .footer-links li { margin-bottom: 10px; }
        .footer-links a { color: var(--text-muted); text-decoration: none; transition: 0.3s; }
        .footer-links a:hover { color: var(--neon-green); padding-left: 4px; }
        .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .back-to-top { width: 38px; height: 38px; background: var(--bg-card); border: 1px solid var(--border-line); color: var(--neon-cyan); border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: 0.3s; }
        .back-to-top:hover { background: var(--neon-cyan); color: #000; transform: translateY(-3px); }

        /* --- Responsive Design (Mobile Timeline Adjustments) --- */
        @media (max-width: 992px) {
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 30px; }
            .page-header h1 { font-size: 2.4rem; }
        }

        @media (max-width: 768px) {
            .nav-menu { display: none; flex-direction: column; position: absolute; top: 100%; left: 0; width: 100%; background: var(--bg-deep); padding: 20px; border-bottom: 1px solid var(--border-line); }
            .nav-menu.active { display: flex; }
            .dropdown { position: static; opacity: 1; visibility: visible; transform: none; background: transparent; border: none; padding-left: 15px; }
            .menu-toggle { display: block; }
            .page-header h1 { font-size: 2rem; }
            
            /* Responsive Single-Column Zigzag for Mobile */
            .zigzag-line-bg, .zigzag-line-fill { left: 24px; transform: none; }
            .zigzag-item, .zigzag-item.left, .zigzag-item.right { width: 100%; align-self: flex-start; justify-content: flex-start; padding-left: 65px; padding-right: 0; }
            .zigzag-node, .zigzag-item.left .zigzag-node, .zigzag-item.right .zigzag-node { left: 0; right: auto; width: 48px; height: 48px; }
            .zigzag-card::before { display: none; }
            .footer-grid { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column; text-align: center; }
        }

        @media (max-width: 480px) {
            .container { padding: 0 16px; }
            .page-header h1 { font-size: 1.7rem; }
            .zigzag-card { padding: 22px; }
            .step-num { font-size: 1.7rem; }
        }
    </style>
