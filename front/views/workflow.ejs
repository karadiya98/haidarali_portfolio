    <script>
        // Mobile Navigation Toggle
        const menuToggle = document.getElementById('menuToggle');
        const navMenu = document.getElementById('navMenu');
        menuToggle.addEventListener('click', () => { navMenu.classList.toggle('active'); });

        // Scroll-Driven Dynamic Zigzag Progress & Node Illumination
        const zigzagWrapper = document.getElementById('zigzagWrapper');
        const zigzagProgress = document.getElementById('zigzagProgress');
        const zigzagItems = document.querySelectorAll('.zigzag-item');

        function handleScrollProgress() {
            const wrapperRect = zigzagWrapper.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            
            // Calculate progress percentage down the zigzag container
            const startY = wrapperRect.top;
            const totalHeight = wrapperRect.height;
            const currentPosition = (viewportHeight / 2) - startY;

            let percentage = (currentPosition / totalHeight) * 100;
            percentage = Math.max(0, Math.min(100, percentage));

            zigzagProgress.style.height = percentage + '%';

            // Illuminate cards as the center fill line reaches them
            zigzagItems.forEach((item) => {
                const itemRect = item.getBoundingClientRect();
                if (itemRect.top <= viewportHeight * 0.65) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
        }

        window.addEventListener('scroll', handleScrollProgress);
        window.addEventListener('load', handleScrollProgress);
    </script>
