                        <div class="skill-tags">
                            <span class="tag">Python</span>
                            <span class="tag">Java</span>
                            <span class="tag">JavaScript (ES6+)</span>
                            <span class="tag">C</span>
                            <span class="tag">SQL</span>
                            <span class="tag">XML</span>
                        </div>
                    </div>

                    <div class="skill-card" data-category="frameworks">
                        <div class="skill-card-header">
                            <i class="fa-solid fa-cubes"></i> Frameworks & Runtimes
                        </div>
                        <div class="skill-tags">
                            <span class="tag">MERN Stack</span>
                            <span class="tag">Django</span>
                            <span class="tag">Node.js</span>
                            <span class="tag">Express.js</span>
                            <span class="tag">React.js</span>
                            <span class="tag">Bootstrap / Tailwind</span>
                        </div>
                    </div>

                    <div class="skill-card" data-category="databases">
                        <div class="skill-card-header">
                            <i class="fa-solid fa-database"></i> Databases & Cloud
                        </div>
                        <div class="skill-tags">
                            <span class="tag">MongoDB</span>
                            <span class="tag">PostgreSQL</span>
                            <span class="tag">SQLite</span>
                            <span class="tag">Firebase Firestore</span>
                            <span class="tag">Firebase Auth</span>
                        </div>
                    </div>

                    <div class="skill-card" data-category="tools">
                        <div class="skill-card-header">
                            <i class="fa-solid fa-gears"></i> Tools & Practices
                        </div>
                        <div class="skill-tags">
                            <span class="tag">Git & GitHub</span>
                            <span class="tag">RESTful API Architecture</span>
                            <span class="tag">Redis Caching</span>
                            <span class="tag">CORS Security</span>
                            <span class="tag">ML Model Integration</span>
                            <span class="tag">Render Deployment</span>
