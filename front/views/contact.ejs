                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2026 Haider Ali. All Rights Reserved.</p>
                <a href="#" class="back-to-top" title="Back to Top"><i class="fa-solid fa-arrow-up"></i></a>
            </div>
        </div>
    </footer>

</body>
</html>