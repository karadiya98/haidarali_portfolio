                        <a href="services">What We Offer</a>
                        <a href="services#why-choose-us">Why Choose Us</a>
                    </div>
                </li>
                <li class="nav-item">
                    <a href="projects" class="nav-link">Projects <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i></a>
                    <div class="dropdown">
                        <a href="projects">Client Projects</a>
                        <a href="projects">Personal Builds</a>
