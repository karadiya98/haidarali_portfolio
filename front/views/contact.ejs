<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haider Ali | Contact Us</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-deep: #050811;
            --bg-surface: rgba(15, 23, 42, 0.65);
            --bg-card: rgba(30, 41, 59, 0.7);
            --bg-card-hover: rgba(51, 65, 85, 0.85);

            --neon-green: #10b981;
            --neon-cyan: #06b6d4;
            --neon-purple: #a855f7;

            --text-white: #f8fafc;
            --text-muted: #94a3b8;
            --border-line: rgba(255, 255, 255, 0.08);

            --main-gradient: linear-gradient(135deg, #10b981 0%, #06b6d4 50%, #a855f7 100%);
            --glow-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; scroll-behavior: smooth; }
        h1, h2, h3, h4, .logo, .slogan-tag, .form-title { font-family: 'Space Grotesk', sans-serif; }

        body { 
            background-color: var(--bg-deep); 
            color: var(--text-white); 
            overflow-x: hidden; 
            line-height: 1.6;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 85% 60%, rgba(168, 85, 247, 0.08) 0%, transparent 45%),
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
            background-attachment: fixed;
            padding-bottom: 0px;
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        /* --- Desktop Header Navigation --- */
        header { 
            position: sticky; 
            top: 0; 
            background: rgba(5, 8, 17, 0.85); 
            backdrop-filter: blur(20px); 
            border-bottom: 1px solid var(--border-line); 
            z-index: 1000; 
            padding: 16px 0; 
        }
        .nav-box { display: flex; justify-content: space-between; align-items: center; }
        .logo { 
            font-size: 1.6rem; 
            font-weight: 700; 
            text-decoration: none; 
            background: var(--main-gradient); 
            
            -webkit-text-fill-color: transparent; 
        }

        .nav-menu { display: flex; gap: 28px; list-style: none; align-items: center; }
        .nav-item { position: relative; }
        .nav-link { color: var(--text-muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; transition: 0.3s; }
        .nav-link:hover, .nav-link.active { color: #fff; }

        .dropdown { position: absolute; top: 120%; left: 0; background: var(--bg-card); backdrop-filter: blur(15px); border: 1px solid var(--border-line); border-radius: 12px; min-width: 200px; padding: 8px 0; opacity: 0; visibility: hidden; transform: translateY(10px); transition: all 0.3s ease; }
        .nav-item:hover .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown a { display: block; padding: 10px 20px; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; }
        .dropdown a:hover { background: var(--bg-card-hover); color: var(--neon-cyan); }

        .btn-enquiry { background: var(--main-gradient); color: #000; padding: 10px 24px; border-radius: 30px; font-weight: 700; text-decoration: none; font-size: 0.9rem; transition: 0.3s; border: none; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
        .btn-enquiry:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(6, 182, 212, 0.45); }

        /* --- Mobile Bottom Navigation --- */
        .mobile-bottom-nav {
            display: none;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 65px;
            background: rgba(5, 8, 17, 0.92);
            backdrop-filter: blur(20px);
            border-top: 1px solid var(--border-line);
            z-index: 2000;
            justify-content: space-around;
            align-items: center;
            padding: 0 10px;
        }

        .mobile-nav-link {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.72rem;
            gap: 4px;
            transition: 0.3s;
            width: 20%;
        }

        .mobile-nav-link i { font-size: 1.2rem; }
        .mobile-nav-link.active, .mobile-nav-link:hover {
            color: var(--neon-cyan);
        }

        /* --- Page Header Banner --- */
        .page-header { text-align: center; padding: 50px 0 30px; }
        .slogan-tag { font-size: 0.95rem; color: var(--neon-cyan); font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px; display: block; }
        .gradient-text { background: var(--main-gradient);  -webkit-text-fill-color: transparent; }
        .page-header h1 { font-size: 2.8rem; margin-bottom: 12px; }
        .page-header p { color: var(--text-muted); max-width: 600px; margin: 0 auto; font-size: 1rem; }

        /* --- Contact Section Layout --- */
        .contact-wrapper {
            display: grid;
            grid-template-columns: 1fr 1.3fr;
            gap: 40px;
            margin: 20px 0 70px;
        }

        .info-card-box {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .info-card {
            background: var(--bg-surface);
            border: 1px solid var(--border-line);
            border-radius: 18px;
            padding: 24px;
            backdrop-filter: blur(14px);
            display: flex;
            align-items: flex-start;
            gap: 20px;
            transition: 0.3s;
        }

        .info-card:hover {
            border-color: var(--neon-cyan);
            transform: translateY(-3px);
            background: var(--bg-card-hover);
        }

        .info-icon {
            width: 50px;
            height: 50px;
            border-radius: 14px;
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.25);
            color: var(--neon-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .info-details h4 {
            font-size: 1.1rem;
            color: var(--text-white);
            margin-bottom: 4px;
        }

        .info-details p, .info-details a {
            color: var(--text-muted);
            font-size: 0.92rem;
            text-decoration: none;
            transition: 0.3s;
        }

        .info-details a:hover {
            color: var(--neon-cyan);
        }

        /* --- Form Glass Container --- */
        .form-container {
            background: var(--bg-surface);
            border: 1px solid var(--border-line);
            border-radius: 20px;
            padding: 35px;
            backdrop-filter: blur(16px);
        }

        .form-title {
            font-size: 1.5rem;
            margin-bottom: 8px;
            color: var(--text-white);
        }

        .form-subtitle {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 24px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-white);
            margin-bottom: 8px;
        }

        .form-input, .form-textarea, .form-select {
            width: 100%;
            background: rgba(5, 8, 17, 0.7);
            border: 1px solid var(--border-line);
            border-radius: 10px;
            padding: 12px 16px;
            color: var(--text-white);
            font-size: 0.95rem;
            outline: none;
            transition: 0.3s;
        }

        .form-input:focus, .form-textarea:focus, .form-select:focus {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 12px rgba(6, 182, 212, 0.25);
        }

        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-textarea {
            resize: vertical;
            min-height: 120px;
        }

        /* --- Footer --- */
        footer { background: #020408; border-top: 1px solid var(--border-line); padding: 50px 0 25px; color: var(--text-muted); font-size: 0.9rem; margin-top: 20px; }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 40px; margin-bottom: 45px; }
        .footer-brand p { margin-top: 12px; font-size: 0.88rem; max-width: 300px; line-height: 1.6; }
        .footer-title { color: var(--text-white); font-size: 1.1rem; font-weight: 700; margin-bottom: 18px; }
        .footer-links { list-style: none; }
        .footer-links li { margin-bottom: 10px; }
        .footer-links a { color: var(--text-muted); text-decoration: none; transition: 0.3s; }
        .footer-links a:hover { color: var(--neon-green); padding-left: 4px; }
        .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .back-to-top { width: 38px; height: 38px; background: var(--bg-card); border: 1px solid var(--border-line); color: var(--neon-cyan); border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: 0.3s; }
        .back-to-top:hover { background: var(--neon-cyan); color: #000; transform: translateY(-3px); }

        /* --- Responsive Queries --- */
        @media (max-width: 992px) {
            .contact-wrapper { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 30px; }
            .page-header h1 { font-size: 2.3rem; }
        }

        @media (max-width: 768px) {
            body { padding-bottom: 70px; }
            .desktop-nav { display: none; }
            .mobile-bottom-nav { display: flex; }
            .page-header { padding: 30px 0 20px; }
            .page-header h1 { font-size: 1.9rem; }
            .form-grid-2 { grid-template-columns: 1fr; }
            .form-container { padding: 24px; }
            .footer-grid { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column; text-align: center; }
        }

        @media (max-width: 480px) {
            .container { padding: 0 16px; }
            .page-header h1 { font-size: 1.6rem; }
        }
    </style>
</head>
<body>

    <!-- Desktop Header Navigation -->
    <header class="desktop-nav">
        <div class="container nav-box">
            <a href="/" class="logo">Haider.dev</a>

            <ul class="nav-menu">
                <li class="nav-item"><a href="/" class="nav-link">About</a></li>
                <li class="nav-item">
                    <a href="services" class="nav-link">Services <i class="fa-solid fa-chevron-down" style="font-size: 0.65rem;"></i></a>
