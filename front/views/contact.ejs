    <main class="container">
        <section class="page-header">
            <span class="slogan-tag">Get In Touch</span>
            <h1>Let's Connect & <span class="gradient-text">Collaborate</span></h1>
            <p>Have questions, feedback, or general technical inquiries? Send a direct message and let's start a conversation.</p>
        </section>

        <section class="contact-wrapper">
            <!-- Left Contact Info Cards -->
            <div class="info-card-box">
                <div class="info-card">
                    <div class="info-icon"><i class="fa-solid fa-envelope"></i></div>
                    <div class="info-details">
                        <h4>Email Communication</h4>
                        <p>Drop a line for technical support or general queries.</p>
                        <a href="mailto:contact@haiderali.dev">contact@haiderali.dev</a>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-icon"><i class="fa-brands fa-whatsapp"></i></div>
                    <div class="info-details">
