                        <p>Available for quick technical consultations via WhatsApp.</p>
                        <a href="https://wa.me/910000000000" target="_blank">+91 (000) 000-0000</a>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div class="info-details">
                        <h4>Base Location</h4>
                        <p>Vadodara / Gujarat, India</p>
                        <span style="font-size: 0.82rem; color: var(--neon-cyan);">Open for Global Remote Projects</span>
                    </div>
