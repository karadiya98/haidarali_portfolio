<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haidar Ali Portfolio</title>
    <!-- Tab bar logo (Favicon) -->
    <link rel="icon" type="image/png" href="images/logo2.png">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ==========================================================================
           1. CORE VARIABLES & RESET
           ========================================================================== */
        :root {
            --bg-dark: #08080a;
            --bg-card: rgba(18, 18, 24, 0.75);
            --bg-glass: rgba(12, 12, 15, 0.85);
            --bg-glass-border: rgba(255, 255, 255, 0.08);
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.35);
            --accent: #10b981;
            --accent-glow: rgba(16, 185, 129, 0.35);
            --neon-cyan: #06b6d4;
            --text-main: #ffffff;
            --text-muted: rgba(255, 255, 255, 0.65);
            --transition-smooth: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-fast: all 0.2s ease;
            --transition-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
            padding-top: 110px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .container {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Ambient Glow Tracker */
        .cursor-glow {
            position: fixed;
            top: 0;
            left: 0;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, var(--primary-glow) 0%, rgba(0,0,0,0) 70%);
            border-radius: 50%;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 0;
            opacity: 0.45;
        }

        /* Main Page Content Wrapper */
        main.container {
            flex: 1;
            width: 100%;
            padding-bottom: 90px;
            position: relative;
            z-index: 1;
        }

        /* ==========================================================================
           2. NAVBAR SECTION
           ========================================================================== */
        .header-nav {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 48px);
            max-width: 1280px;
            z-index: 1000;
            transition: var(--transition-smooth);
        }

        .nav-glass-panel {
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--bg-glass-border);
            border-radius: 100px;
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: -0.02em;
            text-decoration: none;
            color: var(--text-main);
            transition: var(--transition-fast);
        }

        .brand-logo:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }

        .brand-logo-img {
            height: 36px;
            width: auto;
            border-radius: 6px;
            background: #fff;
            padding: 4px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 32px;
        }

        .nav-link {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-muted);
            transition: var(--transition-fast);
            text-decoration: none;
            position: relative;
            padding: 4px 0;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--primary);
            transition: var(--transition-smooth);
            border-radius: 2px;
        }

        .nav-link:hover {
            color: var(--text-main);
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .nav-link.active {
            color: #ffffff;
            font-weight: 600;
        }

        .nav-link.active::after {
            width: 100%;
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
        }

        .btn-glow {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            border-radius: 100px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #000;
            font-weight: 700;
            font-size: 0.875rem;
            transition: var(--transition-bounce);
            box-shadow: 0 0 20px var(--primary-glow);
            border: none;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-glow:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 0 35px var(--primary-glow), 0 0 15px var(--accent-glow);
        }

        .mobile-bottom-appbar {
            display: none;
        }

        @media (max-width: 767px) {
            body {
                padding-bottom: 70px;
            }

            .header-nav {
                top: 12px;
                width: calc(100% - 24px);
            }

            .nav-glass-panel {
                padding: 8px 16px;
            }

            .header-nav .nav-links {
                display: none !important;
            }

            .mobile-bottom-appbar {
                display: block;
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100vw;
                z-index: 10000;
                background: var(--bg-glass);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-top: 1px solid var(--bg-glass-border);
                box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.5);
                padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
            }

            .mobile-app-nav-links {
                display: flex;
                align-items: center;
                justify-content: space-around;
                width: 100%;
            }

            .mobile-app-link {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 3px;
                color: var(--text-muted);
                text-decoration: none;
                font-size: 0.65rem;
                font-weight: 500;
                flex: 1;
                text-align: center;
                transition: var(--transition-fast);
            }

            .mobile-app-link i {
                font-size: 1.2rem;
            }

            .mobile-app-link:hover,
            .mobile-app-link.active {
                color: var(--accent);
            }
        }

        /* ==========================================================================
           3. CONTACT PAGE HEADER & LAYOUT
           ========================================================================== */
        .page-header {
            text-align: center;
            max-width: 800px;
            margin: 10px auto 60px;
        }

        .slogan-tag {
            display: inline-block;
            padding: 6px 18px;
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 100px;
            color: var(--primary);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 18px;
        }

        .page-header h1 {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 18px;
            color: #ffffff;
        }

        .gradient-text {
            background: linear-gradient(135deg, #a5b4fc, var(--primary), var(--accent));
            
            -webkit-text-fill-color: transparent;
        }

        .page-header p {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* Contact Layout Grid */
        .contact-wrapper {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 40px;
            align-items: start;
        }

        /* Left Column Cards */
        .info-card-box {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .info-card {
            background: var(--bg-card);
            border: 1px solid var(--bg-glass-border);
            border-radius: 18px;
            padding: 24px;
            display: flex;
            align-items: flex-start;
            gap: 20px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            transition: var(--transition-smooth);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .info-card:hover {
            transform: translateY(-4px);
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
        }

        .info-icon {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            background: rgba(99, 102, 241, 0.12);
            border: 1px solid rgba(99, 102, 241, 0.25);
            color: var(--primary);
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .info-card:nth-child(2) .info-icon {
            background: rgba(16, 185, 129, 0.12);
            border-color: rgba(16, 185, 129, 0.25);
            color: var(--accent);
        }

        .info-card:nth-child(3) .info-icon {
            background: rgba(6, 182, 212, 0.12);
            border-color: rgba(6, 182, 212, 0.25);
            color: var(--neon-cyan);
        }

        .info-details h4 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .info-details p {
            font-size: 0.9rem;
            color: var(--text-muted);
            margin-bottom: 8px;
            line-height: 1.5;
        }

        .info-details a {
            color: #ffffff;
            font-weight: 600;
            font-size: 0.95rem;
            text-decoration: none;
            transition: var(--transition-fast);
        }

        .info-details a:hover {
            color: var(--accent);
        }

        /* Social Connect Card */
        .social-connect-card {
            background: var(--bg-card);
            border: 1px solid var(--bg-glass-border);
            border-radius: 18px;
            padding: 24px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .social-connect-card h4 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 16px;
        }

        .social-links-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .social-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 12px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--bg-glass-border);
            border-radius: 12px;
            color: var(--text-main);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            transition: var(--transition-fast);
        }

        .social-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        /* Right Form Styling */
        .form-container {
            background: var(--bg-card);
            border: 1px solid var(--bg-glass-border);
            border-radius: 20px;
            padding: 36px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .form-title {
            font-size: 1.5rem;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .form-subtitle {
            font-size: 0.92rem;
            color: var(--text-muted);
            margin-bottom: 28px;
        }

        .form-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 8px;
        }

        .form-input, .form-textarea {
            width: 100%;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 10px;
            padding: 12px 16px;
            color: #ffffff;
            font-size: 0.92rem;
            outline: none;
            transition: var(--transition-fast);
        }

        .form-input:focus, .form-textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 12px var(--primary-glow);
            background: rgba(0, 0, 0, 0.5);
        }

        .form-textarea {
            resize: vertical;
            min-height: 140px;
        }

        .btn-enquiry {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #000000;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: var(--transition-bounce);
            box-shadow: 0 0 20px var(--primary-glow);
            font-size: 0.95rem;
        }

        .btn-enquiry:hover {
            transform: translateY(-2px) scale(1.01);
            box-shadow: 0 0 30px var(--primary-glow), 0 0 15px var(--accent-glow);
        }

        @media (max-width: 992px) {
            .contact-wrapper {
                grid-template-columns: 1fr;
            }

            .page-header h1 {
                font-size: 2.3rem;
            }
        }

        @media (max-width: 576px) {
            .form-grid-2 {
                grid-template-columns: 1fr;
            }

            .social-links-grid {
                grid-template-columns: 1fr;
            }

            .form-container {
                padding: 24px;
            }
        }

        /* ==========================================================================
           4. FOOTER SECTION
           ========================================================================== */
        footer {
            background: var(--bg-glass);
            border-top: 1px solid var(--bg-glass-border);
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            padding: 50px 0 25px;
            margin-top: auto;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            position: relative;
            z-index: 10;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 40px;
            margin-bottom: 30px;
        }

        .footer-brand .brand-logo {
            margin-bottom: 12px;
        }

        .footer-bio {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 18px;
            line-height: 1.6;
        }

        .footer-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.25);
            color: var(--accent);
            padding: 6px 14px;
            border-radius: 100px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent);
        }

        .footer-title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: #ffffff;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            transition: var(--transition-fast);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .footer-links a:hover {
            color: #ffffff;
            transform: translateX(6px);
        }

        .footer-links a i {
            font-size: 0.8rem;
        }

        .footer-links a:hover i {
            color: var(--accent);
        }

        .footer-social-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .social-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            padding: 8px 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--bg-glass-border);
            border-radius: 10px;
            transition: var(--transition-fast);
        }

        .social-badge:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
        }

        .social-badge:hover i {
            color: var(--primary);
        }

        .btn-whatsapp-glow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #25d366;
            color: #000000;
            padding: 10px 20px;
            border-radius: 100px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.88rem;
            transition: var(--transition-bounce);
            box-shadow: 0 0 15px rgba(37, 211, 102, 0.3);
            width: 100%;
        }

        .btn-whatsapp-glow:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 0 25px rgba(37, 211, 102, 0.6);
            background: #28e16d;
        }

        .footer-divider {
            height: 1px;
            background: var(--bg-glass-border);
            margin: 25px 0;
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .back-to-top {
            width: 38px;
            height: 38px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: var(--transition-fast);
        }

        .back-to-top:hover {
            background: var(--primary);
            color: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 0 15px var(--primary-glow);
        }

        @media (max-width: 992px) {
            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 30px;
            }
        }

        @media (max-width: 576px) {
            .footer-grid {
                grid-template-columns: 1fr;
            }
            .footer-bottom {
                flex-direction: column;
                gap: 16px;
                text-align: center;
            }
        }
    </style>
</head>
