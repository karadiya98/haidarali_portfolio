    <script>
        // Mobile Menu Toggle
        const menuToggle = document.getElementById('menuToggle');
        const navMenu = document.getElementById('navMenu');
        menuToggle.addEventListener('click', () => { navMenu.classList.toggle('active'); });

        // Tab Switching Logic
        const clientTabBtn = document.getElementById('clientTabBtn');
        const personalTabBtn = document.getElementById('personalTabBtn');
        const clientProjectsContent = document.getElementById('clientProjectsContent');
        const personalBuildsContent = document.getElementById('personalBuildsContent');

        function switchTab(showClient) {
            if (showClient) {
                clientTabBtn.classList.add('active');
                clientProjectsContent.classList.add('active');
                personalTabBtn.classList.remove('active');
                personalBuildsContent.classList.remove('active');
            } else {
                personalTabBtn.classList.add('active');
                personalBuildsContent.classList.add('active');
                clientTabBtn.classList.remove('active');
                clientProjectsContent.classList.remove('active');
            }
        }

        clientTabBtn.addEventListener('click', () => switchTab(true));
        personalTabBtn.addEventListener('click', () => switchTab(false));

        // Accordion Dropdown Logic for Project Cards
        function toggleAccordion(headerElement) {
            const card = headerElement.parentElement;
            card.classList.toggle('open');
        }

        // URL Hash Deep-linking Handler
        window.addEventListener('load', () => {
            if (window.location.hash === '#personal-builds') {
                switchTab(false);
            } else if (window.location.hash === '#client-projects') {
                switchTab(true);
            }
        });
    </script>
