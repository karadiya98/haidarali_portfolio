<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haider Ali portfolio</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #050811;
            --bg-surface: rgba(15, 23, 42, 0.65);
            --bg-card: rgba(30, 41, 59, 0.7);
            --bg-card-hover: rgba(51, 65, 85, 0.85);
            
            --neon-green: #10b981;
            --neon-cyan: #06b6d4;
            --neon-purple: #a855f7;
            
            --text-white: #f8fafc;
            --text-muted: #94a3b8;
            --border-line: rgba(255, 255, 255, 0.08);
            
            --main-gradient: linear-gradient(135deg, #10b981 0%, #06b6d4 50%, #a855f7 100%);
            --glow-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; scroll-behavior: smooth; }
        h1, h2, h3, h4, .logo, .stat-num, .slogan-tag, .tab-btn, .project-title { font-family: 'Space Grotesk', sans-serif; }
        
        body { 
            background-color: var(--bg-deep); 
            color: var(--text-white); 
            overflow-x: hidden; 
            line-height: 1.5;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 85% 60%, rgba(168, 85, 247, 0.08) 0%, transparent 45%),
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
            background-attachment: fixed;
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        /* --- Fixed Header Navigation --- */
        header { 
            position: sticky; 
            top: 0; 
            background: rgba(5, 8, 17, 0.85); 
            backdrop-filter: blur(20px); 
            border-bottom: 1px solid var(--border-line); 
            z-index: 1000; 
            padding: 16px 0; 
        }
        .nav-box { display: flex; justify-content: space-between; align-items: center; }
        .logo { 
            font-size: 1.6rem; 
            font-weight: 700; 
            text-decoration: none; 
            background: var(--main-gradient); 
            -webkit-text-fill-color: transparent; 
        }

        .nav-menu { display: flex; gap: 28px; list-style: none; align-items: center; }
        .nav-item { position: relative; }
        .nav-link { color: var(--text-muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; transition: 0.3s; }
        .nav-link:hover, .nav-link.active { color: #fff; }

        .dropdown { position: absolute; top: 120%; left: 0; background: var(--bg-card); backdrop-filter: blur(15px); border: 1px solid var(--border-line); border-radius: 12px; min-width: 200px; padding: 8px 0; opacity: 0; visibility: hidden; transform: translateY(10px); transition: all 0.3s ease; }
        .nav-item:hover .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown a { display: block; padding: 10px 20px; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; }
        .dropdown a:hover { background: var(--bg-card-hover); color: var(--neon-cyan); }

        .btn-enquiry { background: var(--main-gradient); color: #000; padding: 10px 24px; border-radius: 30px; font-weight: 700; text-decoration: none; font-size: 0.9rem; transition: 0.3s; border: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-enquiry:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(6, 182, 212, 0.45); }
        .menu-toggle { display: none; color: #fff; font-size: 1.5rem; cursor: pointer; }

        /* --- Page Header Banner --- */
        .page-header { text-align: center; padding: 50px 0 15px; }
        .slogan-tag { font-size: 0.85rem; color: var(--neon-cyan); font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px; display: block; }
        .gradient-text { background: var(--main-gradient);  -webkit-text-fill-color: transparent; }
        .page-header h1 { font-size: 2.3rem; margin-bottom: 8px; }
        .page-header p { color: var(--text-muted); max-width: 600px; margin: 0 auto; font-size: 0.9rem; }

        /* --- TAB NAVIGATION TOGGLE --- */
        .tabs-wrapper { display: flex; justify-content: center; margin: 30px 0 40px; }
        .tab-container { background: var(--bg-card); border: 1px solid var(--border-line); border-radius: 40px; padding: 5px; display: flex; gap: 6px; box-shadow: 0 8px 30px rgba(0,0,0,0.5); }
        .tab-btn { background: transparent; border: none; color: var(--text-muted); padding: 10px 24px; font-size: 0.88rem; font-weight: 600; border-radius: 30px; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; gap: 8px; }
        .tab-btn i { font-size: 0.85rem; }
        .tab-btn.active { background: var(--main-gradient); color: #000; box-shadow: 0 0 20px rgba(16, 185, 129, 0.3); }

        /* --- TAB CONTENT SECTIONS --- */
        .tab-content { display: none; opacity: 0; transition: opacity 0.4s ease-in-out; min-height: 400px; }
        .tab-content.active { display: block; opacity: 1; }

        /* --- PROJECT ACCORDION LIST STYLES --- */
        .projects-list { display: flex; flex-direction: column; gap: 14px; margin-bottom: 60px; }
        .project-card { 
            background: var(--bg-card); 
            border: 1px solid var(--border-line); 
            border-radius: 12px; 
            overflow: hidden; 
            transition: border-color 0.3s ease, transform 0.3s ease;
            backdrop-filter: blur(10px);
        }
        .project-card:hover { border-color: rgba(6, 182, 212, 0.4); }

        .project-header-bar { 
            padding: 16px 22px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            cursor: pointer; 
            user-select: none;
            transition: background 0.3s;
        }
        .project-header-bar:hover { background: var(--bg-card-hover); }

        .project-title-group { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .project-title { font-size: 1.05rem; font-weight: 600; color: var(--text-white); }
        
        .badge { 
            font-size: 0.68rem; 
            padding: 3px 10px; 
            border-radius: 20px; 
            font-weight: 600; 
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .badge-client { background: rgba(16, 185, 129, 0.15); color: var(--neon-green); border: 1px solid rgba(16, 185, 129, 0.3); }
        .badge-personal { background: rgba(168, 85, 247, 0.15); color: var(--neon-purple); border: 1px solid rgba(168, 85, 247, 0.3); }

        .accordion-icon { 
            width: 30px; 
            height: 30px; 
            border-radius: 50%; 
            background: rgba(255, 255, 255, 0.05); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: var(--neon-cyan);
            font-size: 0.75rem;
            transition: transform 0.3s ease;
        }
        .project-card.open .accordion-icon { transform: rotate(180deg); background: rgba(6, 182, 212, 0.2); }

        /* Expandable Drawer Body */
        .project-details { 
            max-height: 0; 
            overflow: hidden; 
            transition: max-height 0.4s cubic-bezier(0, 1, 0, 1), padding 0.3s ease;
            background: rgba(15, 23, 42, 0.4);
            border-top: 1px solid transparent;
        }
        .project-card.open .project-details { 
            max-height: 800px; 
            padding: 18px 22px; 
            border-top-color: var(--border-line);
            transition: max-height 0.4s cubic-bezier(1, 0, 1, 0), padding 0.3s ease;
        }

        /* Clean Text-Only Drawer Meta Grid */
        .project-meta-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .meta-row {
            display: flex;
            align-items: baseline;
            gap: 10px;
            font-size: 0.85rem;
        }

        .meta-label {
            font-weight: 600;
            color: var(--neon-cyan);
            min-width: 120px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .meta-value {
            color: var(--text-muted);
            line-height: 1.5;
        }

        .project-desc { color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; }
        
        .tech-stack { display: flex; gap: 6px; flex-wrap: wrap; }
        .tech-tag { font-size: 0.72rem; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border-line); color: var(--text-white); padding: 3px 10px; border-radius: 6px; }

        .project-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
        .btn-action { 
            padding: 6px 14px; 
            border-radius: 6px; 
            font-size: 0.78rem; 
            font-weight: 600; 
            text-decoration: none; 
            display: inline-flex; 
            align-items: center; 
            gap: 6px; 
            transition: 0.3s; 
        }
        .btn-live { background: var(--neon-cyan); color: #000; }
        .btn-live:hover { background: #22d3ee; box-shadow: 0 0 12px rgba(6, 182, 212, 0.4); }
        .btn-github { background: rgba(255, 255, 255, 0.08); color: var(--text-white); border: 1px solid var(--border-line); }
        .btn-github:hover { background: rgba(255, 255, 255, 0.15); border-color: var(--text-white); }

        /* --- FOOTER --- */
        footer { background: #020408; border-top: 1px solid var(--border-line); padding: 60px 0 25px; color: var(--text-muted); font-size: 0.9rem; margin-top: 40px; }
        .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1.5fr; gap: 40px; margin-bottom: 45px; }
        .footer-brand p { margin-top: 12px; font-size: 0.88rem; max-width: 300px; line-height: 1.6; }
        .footer-title { color: var(--text-white); font-size: 1.1rem; font-weight: 700; margin-bottom: 18px; }
        .footer-links { list-style: none; }
        .footer-links li { margin-bottom: 10px; }
        .footer-links a { color: var(--text-muted); text-decoration: none; transition: 0.3s; }
        .footer-links a:hover { color: var(--neon-green); padding-left: 4px; }
        .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 25px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        .back-to-top { width: 38px; height: 38px; background: var(--bg-card); border: 1px solid var(--border-line); color: var(--neon-cyan); border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; transition: 0.3s; }
        .back-to-top:hover { background: var(--neon-cyan); color: #000; transform: translateY(-3px); }

        /* --- RESPONSIVE MEDIA QUERIES --- */
        @media (max-width: 992px) {
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 30px; }
            .page-header h1 { font-size: 2rem; }
        }

        @media (max-width: 768px) {
            .nav-menu { display: none; flex-direction: column; position: absolute; top: 100%; left: 0; width: 100%; background: var(--bg-deep); padding: 20px; border-bottom: 1px solid var(--border-line); }
            .nav-menu.active { display: flex; }
            .dropdown { position: static; opacity: 1; visibility: visible; transform: none; background: transparent; border: none; padding-left: 15px; }
            .menu-toggle { display: block; }
            .page-header h1 { font-size: 1.8rem; }
            .tab-btn { padding: 8px 16px; font-size: 0.82rem; }
            .footer-grid { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column; text-align: center; }
            .project-header-bar { padding: 14px 16px; }
            .meta-row { flex-direction: column; gap: 2px; }
            .meta-label { min-width: auto; }
        }

        @media (max-width: 480px) {
            .container { padding: 0 16px; }
            .tab-container { width: 100%; justify-content: center; }
            .tab-btn { padding: 8px 10px; font-size: 0.75rem; gap: 4px; }
            .page-header h1 { font-size: 1.5rem; }
            .project-card.open .project-details { padding: 14px 16px; }
        }
       
:root {
    --bg-deep: #050811;
    --bg-card: rgba(30, 41, 59, 0.7);
    --bg-card-hover: rgba(51, 65, 85, 0.85);
    --neon-green: #10b981;
    --neon-cyan: #06b6d4;
    --neon-purple: #a855f7;
    --text-white: #f8fafc;
