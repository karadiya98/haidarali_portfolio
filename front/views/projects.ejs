    <!-- JAVASCRIPT -->
    <script>
        // Cursor Glow Follower
        const cursorGlow = document.getElementById('cursorGlow');
        document.addEventListener('mousemove', (e) => {
            cursorGlow.style.left = e.clientX + 'px';
            cursorGlow.style.top = e.clientY + 'px';
        });

        // Detailed Projects Dataset (Text-Focused)
        const projectsData = [
            {
                title: "AdVitum Healthcare",
                category: "Client Work",
                desc: "A full-scale B2B wholesale platform for medical distribution, enabling seamless inventory browsing, real-time pricing calculation, and bulk order placements for pharmacy networks.",
                tech: ["Node.js", "Express", "MongoDB", "EJS", "Tailwind CSS"],
                features: [
                    "High-speed product search across large medical inventory catalog",
                    "Customized pricing levels for authenticated clients",
                    "Session management and secure admin control portal",
                    "Fully responsive custom layout with Glassmorphism aesthetic"
                ],
                github: "https://github.com/karadiya98",
                live: "https://advitum.com"
            },
            {
                title: "Yash Domestic Survey App",
                category: "Client Work",
                desc: "Custom Android application engineered for field surveyors to track, geo-tag, and record street animal sightings with offline storage synchronization to a web admin system.",
                tech: ["Java", "Android SDK", "Firebase", "REST APIs", "Google Maps API"],
                features: [
                    "GPS auto-location tagging for precise sighting mapping",
                    "Camera module integration with cloud asset storage",
                    "RESTful communication layer connecting field agents with MERN backend",
                    "Interactive GIS tracking dashboard for municipal analysis"
                ],
                github: "https://github.com/karadiya98",
                live: ""
            },
            {
                title: "StayFound Rental Marketplace",
                category: "Personal Project",
                desc: "Full-stack rental marketplace matching travelers with property owners, featuring interactive Mapbox views, user reviews, dynamic pricing, and instant booking processing.",
                tech: ["React.js", "Node.js", "Express.js", "MongoDB", "Mapbox SDK"],
                features: [
                    "OAuth & JWT based secure user authentication",
                    "Map-based property discovery powered by Mapbox",
                    "Rating & Review system with media uploads",
                    "RESTful API design with scalable document collections"
                ],
                github: "https://github.com/karadiya98",
                live: "https://stayfound.example.com"
            }
        ];

        // Filtering Tab Mechanism
        const tabBtns = document.querySelectorAll('.tab-btn');
        const projectCards = document.querySelectorAll('.project-card');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                tabBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                const filter = btn.getAttribute('data-filter');

                projectCards.forEach(card => {
                    if (filter === 'all' || card.getAttribute('data-category') === filter) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });

        // Modal Open Logic
        const projectModal = document.getElementById('projectModal');
        const modalDynamicContent = document.getElementById('modalDynamicContent');

        function openProjectModal(index) {
            const data = projectsData[index];
            if (!data) return;

            const featuresList = data.features.map(f => `<li><i class="fa-solid fa-check"></i> ${f}</li>`).join('');
            const techBadges = data.tech.map(t => `<span class="tech-tag">${t}</span>`).join('');
            const liveBtn = data.live ? `<a href="${data.live}" target="_blank" class="btn-card btn-card-primary"><i class="fa-solid fa-arrow-up-right-from-square"></i> Live Demo</a>` : '';

            modalDynamicContent.innerHTML = `
                <span class="project-badge ${data.category === 'Client Work' ? 'badge-client' : 'badge-personal'}" style="display:inline-block; margin-bottom:12px;">${data.category}</span>
                <h2 style="font-size: 1.6rem; color:#fff; margin-bottom: 12px;">${data.title}</h2>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px;">${data.desc}</p>
                
                <h4 style="font-size: 0.95rem; color: #fff; margin-bottom: 8px;">Technologies Used:</h4>
                <div class="modal-tech-stack">${techBadges}</div>
                
                <h4 style="font-size: 0.95rem; color: #fff; margin-bottom: 8px;">Key Deliverables & Features:</h4>
                <ul class="modal-features">${featuresList}</ul>

                <div class="project-actions" style="margin-top:24px;">
                    <a href="${data.github}" target="_blank" class="btn-card btn-card-outline"><i class="fa-brands fa-github"></i> GitHub Repository</a>
                    ${liveBtn}
                </div>
            `;

            projectModal.classList.add('active');
        }

        // Modal Close Logic
        const projectModalClose = document.getElementById('projectModalClose');
        if (projectModalClose) {
            projectModalClose.addEventListener('click', () => {
                projectModal.classList.remove('active');
            });
        }

        window.addEventListener('click', (e) => {
            if (e.target === projectModal) {
                projectModal.classList.remove('active');
            }
        });
    </script>
