<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haidar Ali — Full-Stack & Android Systems Engineer</title>
    
    <meta name="description" content="Portfolio of Haidar Ali — Full-Stack MERN & Android Engineer crafting scalable web applications, real-time GPS tracking systems, and high-performance custom software solutions.">
    <meta name="keywords" content="Haidar Ali, Full Stack Developer, MERN, Android, Java, Vadodara Developer, Node.js, React">
    <meta name="author" content="Haidar Ali">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Pro 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* ==========================================================================
           1. CORE ENGINE & THEME CONSTANTS
           ========================================================================== */
        :root {
            --bg-base: #030712;
            --bg-surface: #0b0f19;
            --bg-surface-elevated: #111827;
            --bg-glass: rgba(17, 24, 39, 0.75);
            --bg-glass-border: rgba(255, 255, 255, 0.08);
            --bg-glass-hover: rgba(255, 255, 255, 0.12);
            
            --primary: #06b6d4;
            --primary-glow: rgba(6, 182, 212, 0.35);
            --accent: #10b981;
            --accent-glow: rgba(16, 185, 129, 0.35);
            --purple: #a855f7;
            --purple-glow: rgba(168, 85, 247, 0.35);
            --amber: #f59e0b;
            
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --text-subtle: #6b7280;
            
            --border-light: rgba(255, 255, 255, 0.06);
            --border-focus: rgba(6, 182, 212, 0.5);
            
            --radius-sm: 8px;
            --radius-md: 16px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            
            --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            --transition-smooth: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            --transition-bounce: 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            
            --shadow-subtle: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }

        /* ==========================================================================
           2. GLOBAL RESET & BASE STYLES
           ========================================================================== */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            color-scheme: dark;
            background-color: var(--bg-base);
            font-family: var(--font-sans);
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }

        body {
            color: var(--text-main);
            overflow-x: hidden;
            line-height: 1.6;
            background: 
                radial-gradient(circle at 10% 10%, rgba(6, 182, 212, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 90% 60%, rgba(168, 85, 247, 0.05) 0%, transparent 40%),
                var(--bg-base);
            min-height: 100vh;
        }

        .cursor-glow {
            position: fixed;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(6, 182, 212, 0.08) 0%, rgba(16, 185, 129, 0) 70%);
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 0;
            transition: left 0.1s ease-out, top 0.1s ease-out;
        }

        a { color: inherit; text-decoration: none; }
        ul { list-style: none; }
        img { max-width: 100%; display: block; }

        .container {
            width: 100%;
            max-width: 1360px;
            margin: 0 auto;
            padding: 0 24px;
            position: relative;
            z-index: 2;
        }

        section {
            padding: 100px 0;
            position: relative;
        }

        .section-header {
            text-align: center;
            max-width: 720px;
            margin: 0 auto 64px auto;
        }

        .section-header .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px;
            border-radius: 100px;
            background: rgba(6, 182, 212, 0.08);
            border: 1px solid rgba(6, 182, 212, 0.2);
            color: var(--primary);
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .section-header h2 {
            font-size: clamp(2rem, 3.5vw, 2.8rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, #ffffff 30%, var(--text-muted) 100%);
            
            -webkit-text-fill-color: transparent;
            margin-bottom: 16px;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 1.05rem;
            line-height: 1.7;
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-base); }
        ::-webkit-scrollbar-thumb { background: #1f293d; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--primary); }

        /* ==========================================================================
           3. NAVBAR SECTION
           ========================================================================== */
        .header-nav {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 48px);
            max-width: 1280px;
            z-index: 1000;
            transition: var(--transition-smooth);
        }

        .nav-glass-panel {
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--bg-glass-border);
            border-radius: 100px;
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: -0.02em;
        }

        .brand-logo-img {
            height: 36px;
            width: auto;
            border-radius: 6px;
            background: #fff;
            padding: 4px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 32px;
        }

        .nav-link {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-muted);
            transition: var(--transition-fast);
        }

        .nav-link:hover { color: var(--text-main); }

        .btn-glow {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            border-radius: 100px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #000;
            font-weight: 700;
            font-size: 0.875rem;
            transition: var(--transition-bounce);
            box-shadow: 0 0 20px var(--primary-glow);
            border: none;
            cursor: pointer;
        }

        .btn-glow:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 0 35px var(--primary-glow);
        }

        /* ==========================================================================
           4. HERO SECTION (PROFILE PHOTO + ABOUT ME)
           ========================================================================== */
        .hero-section {
            padding-top: 170px;
            padding-bottom: 60px;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            align-items: center;
            gap: 56px;
        }

        .dev-photo-card {
            position: relative;
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-xl);
            padding: 24px;
            box-shadow: var(--shadow-subtle), 0 0 60px rgba(6, 182, 212, 0.08);
            transition: var(--transition-smooth);
        }

        .dev-photo-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-focus);
        }

        .photo-wrapper {
            position: relative;
            width: 100%;
            height: 420px;
            border-radius: var(--radius-lg);
            overflow: hidden;
            background: var(--bg-surface-elevated);
        }

        .dev-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
            transition: transform 0.6s ease;
        }

        .dev-photo-card:hover .dev-img {
            transform: scale(1.04);
        }

        .photo-info-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 24px;
            background: linear-gradient(180deg, transparent 0%, rgba(3, 7, 18, 0.95) 100%);
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
        }

        .photo-info-overlay h3 { font-size: 1.3rem; font-weight: 700; }
        .photo-info-overlay p { font-size: 0.85rem; color: var(--primary); font-family: var(--font-mono); }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            border-radius: 100px;
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.2);
            color: var(--accent);
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 24px;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 10px var(--accent);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        .hero-title {
            font-size: clamp(2.4rem, 4vw, 3.6rem);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.03em;
            margin-bottom: 20px;
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 50%, var(--purple) 100%);
            
            -webkit-text-fill-color: transparent;
        }

        .hero-about-text {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.75;
            margin-bottom: 36px;
        }

        .hero-cta-group {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .btn-secondary-glass {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 28px;
            border-radius: 100px;
            background: var(--bg-glass);
            border: 1px solid var(--bg-glass-border);
            color: var(--text-main);
            font-weight: 600;
            transition: var(--transition-smooth);
        }

        .btn-secondary-glass:hover {
            background: var(--bg-glass-hover);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        /* ==========================================================================
           5. METRICS / NUMBERS STATS SECTION
           ========================================================================== */
        .stats-section {
            padding: 40px 0 80px 0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .stat-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-lg);
            padding: 32px 24px;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: var(--transition-smooth);
        }

        .stat-card:hover {
            transform: translateY(-6px);
            border-color: var(--primary);
            box-shadow: 0 15px 35px -10px var(--primary-glow);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            opacity: 0;
            transition: var(--transition-fast);
        }

        .stat-card:hover::before { opacity: 1; }

        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            font-family: var(--font-mono);
            background: linear-gradient(135deg, #fff, var(--text-muted));
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            line-height: 1;
        }
a
        .stat-label {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* ==========================================================================
           6. TECHNICAL SKILLS SECTION
           ========================================================================== */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .skill-group-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-lg);
            padding: 32px;
            transition: var(--transition-smooth);
        }

        .skill-group-card:hover {
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-4px);
        }

        .skill-group-title {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 24px;
            color: var(--text-main);
        }

        .skill-group-title i {
            color: var(--primary);
            font-size: 1.3rem;
        }

        .skills-badge-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .skill-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border-light);
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-main);
            transition: var(--transition-fast);
        }

        .skill-badge:hover {
            border-color: var(--primary);
            background: rgba(6, 182, 212, 0.1);
            color: var(--primary);
            transform: translateY(-2px);
        }

        .skill-badge i { font-size: 1rem; }

        /* ==========================================================================
           7. CERTIFICATES HORIZONTAL AUTO-SCROLL CAROUSEL
           ========================================================================== */
        .certificates-section {
            background: var(--bg-surface);
            border-top: 1px solid var(--border-light);
            border-bottom: 1px solid var(--border-light);
            overflow: hidden;
        }

        .marquee-container {
            width: 100%;
            overflow: hidden;
            position: relative;
            mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
            -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
        }

        .marquee-track {
            display: flex;
            gap: 28px;
            width: max-content;
            animation: infiniteScroll 25s linear infinite;
        }

        .marquee-container:hover .marquee-track {
            animation-play-state: paused;
        }

        @keyframes infiniteScroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .cert-card {
            width: 320px;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-md);
            padding: 16px;
            cursor: pointer;
            transition: var(--transition-smooth);
            flex-shrink: 0;
        }

        .cert-card:hover {
            transform: translateY(-4px);
            border-color: var(--primary);
            box-shadow: 0 10px 25px -5px var(--primary-glow);
        }

        .cert-img-wrapper {
            width: 100%;
            height: 180px;
            border-radius: var(--radius-sm);
            overflow: hidden;
            margin-bottom: 14px;
            background: var(--bg-base);
        }

        .cert-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .cert-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cert-card p {
            font-size: 0.8rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ==========================================================================
           8. CLIENT 4 WORKS (EXACT 4-COLUMN SINGLE ROW GRID)
           ========================================================================== */
        .projects-4col-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .project-micro-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-md);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: var(--transition-smooth);
            text-decoration: none;
            color: inherit;
            height: 100%;
        }

        .project-micro-card:hover {
            transform: translateY(-8px);
            border-color: rgba(6, 182, 212, 0.5);
            box-shadow: 0 20px 40px -15px rgba(0,0,0,0.8), 0 0 25px var(--primary-glow);
        }

        .card-img-wrapper {
            position: relative;
            width: 100%;
            height: 160px;
            overflow: hidden;
            background: var(--bg-surface-elevated);
        }

        .project-micro-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .project-micro-card:hover .project-micro-img {
            transform: scale(1.08);
        }

        .live-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(3, 7, 18, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 6px;
            z-index: 2;
        }

        .live-badge i { font-size: 0.45rem; color: var(--accent); }

        .card-body {
            padding: 18px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .card-body h4 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-main);
            transition: var(--transition-fast);
        }

        .project-micro-card:hover .card-body h4 { color: var(--primary); }

        .card-body p {
            font-size: 0.825rem;
            color: var(--text-muted);
            margin-bottom: 16px;
            line-height: 1.5;
            flex-grow: 1;
        }

        .card-tech-stack {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 16px;
        }

        .card-tech-stack span {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-light);
            color: var(--primary);
        }

        .card-footer-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 12px;
            border-top: 1px solid var(--border-light);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-subtle);
        }

        .project-micro-card:hover .card-footer-link { color: var(--text-main); }

        .view-more-container {
            text-align: center;
            margin-top: 52px;
        }

        .btn-view-more {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 32px;
            border-radius: 100px;
            background: var(--bg-glass);
            border: 1px solid var(--bg-glass-border);
            color: var(--text-main);
            font-weight: 700;
            transition: var(--transition-smooth);
        }

        .btn-view-more:hover {
            background: var(--primary);
            color: #000;
            box-shadow: 0 0 30px var(--primary-glow);
            transform: translateY(-2px);
        }

        /* ==========================================================================
           9. SOCIAL & PROFESSIONAL LINKS SECTION
           ========================================================================== */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .social-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-lg);
            padding: 32px;
            text-align: center;
            transition: var(--transition-smooth);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .social-card:hover {
            transform: translateY(-6px);
            border-color: var(--primary);
            box-shadow: 0 10px 30px -10px var(--primary-glow);
        }

        .social-icon {
            font-size: 2.5rem;
            margin-bottom: 16px;
            transition: transform 0.4s var(--transition-bounce);
        }

        .social-card:hover .social-icon {
            transform: scale(1.15) rotate(5deg);
        }

        .social-card h4 {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .social-card p {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* ==========================================================================
           10. CREATIVITY SECTION (INTERACTIVE COST ESTIMATOR + TERMINAL)
           ========================================================================== */
        .creativity-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
        }

        .creative-widget-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-xl);
            padding: 36px;
            position: relative;
        }

        .widget-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Interactive Terminal */
        .terminal-box {
            background: #020617;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-md);
            padding: 20px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: #38bdf8;
            height: 220px;
            overflow-y: auto;
        }

        .terminal-line { margin-bottom: 8px; }
        .terminal-prompt { color: var(--accent); margin-right: 8px; }

        /* Project Cost Estimator Widget */
        .estimator-group {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .estimator-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-surface-elevated);
            padding: 12px 20px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-light);
            cursor: pointer;
            transition: var(--transition-fast);
        }

