    <script>
        // Mobile Menu Toggle
        const menuToggle = document.getElementById('menuToggle');
        const navMenu = document.getElementById('navMenu');
        menuToggle.addEventListener('click', () => { navMenu.classList.toggle('active'); });

        // Tab Switching Logic
        const offerTabBtn = document.getElementById('offerTabBtn');
        const whyTabBtn = document.getElementById('whyTabBtn');
        const whatWeOfferContent = document.getElementById('whatWeOfferContent');
        const whyChooseUsContent = document.getElementById('whyChooseUsContent');

        function switchTab(showOffer) {
            if (showOffer) {
                offerTabBtn.classList.add('active');
                whatWeOfferContent.classList.add('active');
                whyTabBtn.classList.remove('active');
                whyChooseUsContent.classList.remove('active');
            } else {
                whyTabBtn.classList.add('active');
                whyChooseUsContent.classList.add('active');
                offerTabBtn.classList.remove('active');
                whatWeOfferContent.classList.remove('active');
            }
        }

        offerTabBtn.addEventListener('click', () => switchTab(true));
        whyTabBtn.addEventListener('click', () => switchTab(false));

        // URL Deep-linking handler
        window.addEventListener('load', () => {
            if (window.location.hash === '#why-choose-us') {
                switchTab(false);
            }
        });
    </script>
