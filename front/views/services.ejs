            </a>
            <a href="/contact" class="mobile-app-link">
                <i class="fa-solid fa-paper-plane"></i>
                <span>Contact</span>
            </a>
        </nav>
    </div>

    <!-- MAIN CONTENT -->
  <div class="container">
        
    <section class="page-header">
        <strong class="slogan-tag">Engineering Digital Scale</strong>
        <h1>Expert Technical <em>Services</em></h1>
        <p>Transforming complex business requirements into robust engineered systems with IT solutions.</p>
    </section>

    <!-- Tabs -->
    <div class="tabs-wrapper">
        <div class="tab-container">
            <button class="tab-btn active" id="offerTabBtn" onclick="switchTab('whatWeOfferContent', 'offerTabBtn')">
                <i class="fa-solid fa-cubes"></i> What we Do 
            </button>
            <button class="tab-btn" id="whyTabBtn" onclick="switchTab('whyChooseUsContent', 'whyTabBtn')">
                <i class="fa-solid fa-shield-halved"></i> Why Choose Us
            </button>
        </div>
    </div>

    <!-- TAB 1: What We Offer -->
    <div class="tab-content active" id="whatWeOfferContent">
