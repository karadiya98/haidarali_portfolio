/* --- Mobile Bottom Navigation --- */
.mobile-bottom-nav {
    display: none; position: fixed; bottom: 0; left: 0; right: 0;
    height: 65px; background: rgba(5, 8, 17, 0.92);
    backdrop-filter: blur(20px); border-top: 1px solid var(--border-line);
    z-index: 2000; justify-content: space-around; align-items: center; padding: 0 10px;
}
.mobile-nav-link {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; color: var(--text-muted);
    text-decoration: none; font-size: 0.72rem; gap: 4px; transition: 0.3s; width: 20%;
}
.mobile-nav-link i { font-size: 1.2rem; }
.mobile-nav-link.active, .mobile-nav-link:hover { color: var(--neon-cyan); }

/* --- Footer --- */
footer { background: #020408; border-top: 1px solid var(--border-line); padding: 50px 0 25px; color: var(--text-muted); font-size: 0.9rem; margin-top: 20px; }
