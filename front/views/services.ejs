        const offerTabBtn = document.getElementById('offerTabBtn');
        const whyTabBtn = document.getElementById('whyTabBtn');
        const offerContent = document.getElementById('whatWeOfferContent');
        const whyContent = document.getElementById('whyChooseUsContent');

        offerTabBtn.addEventListener('click', () => {
