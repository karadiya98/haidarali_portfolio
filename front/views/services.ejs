<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expert Technical Services - Haidar Ali</title>
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ==========================================================================
           1. CORE VARIABLES & BASE RESET
           ========================================================================== */
        :root {
            --bg-dark: #08080a;
            --bg-card: rgba(18, 18, 24, 0.7);
            --bg-glass: rgba(12, 12, 15, 0.85);
            --bg-glass-border: rgba(255, 255, 255, 0.08);
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.35);
            --accent: #10b981;
            --accent-glow: rgba(16, 185, 129, 0.35);
            --text-main: #ffffff;
            --text-muted: rgba(255, 255, 255, 0.65);
            --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-fast: all 0.2s ease;
            --transition-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
            padding-top: 100px;
            padding-bottom: 0; /* REMOVED Extra Bottom Space */
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .container {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Ambient Glow Tracker */
        .cursor-glow {
            position: fixed;
            top: 0;
            left: 0;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, var(--primary-glow) 0%, rgba(0,0,0,0) 70%);
            border-radius: 50%;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 0;
            opacity: 0.5;
            transition: width 0.3s, height 0.3s;
        }

        /* ==========================================================================
           2. PAGE HEADER & SWITCHING TABS
           ========================================================================== */
        .page-header {
            text-align: center;
            margin: 40px 0 32px 0;
        }

        .slogan-tag {
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-size: 0.85rem;
            font-weight: 700;
            display: inline-block;
            margin-bottom: 12px;
        }

        .page-header h1 {
            font-size: 2.8rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 16px;
        }

        .page-header h1 em {
            color: var(--primary);
            font-style: normal;
        }

        .page-header p {
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto;
            font-size: 1.05rem;
            line-height: 1.6;
        }

        .tabs-wrapper {
            display: flex;
            justify-content: center;
            margin-bottom: 48px;
        }

        .tab-container {
            background: var(--bg-glass);
            border: 1px solid var(--bg-glass-border);
            padding: 6px;
            border-radius: 100px;
            display: flex;
            gap: 8px;
            backdrop-filter: blur(10px);
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 12px 28px;
            border-radius: 100px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            transition: var(--transition-smooth);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .tab-btn:hover:not(.active) {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
        }

        .tab-btn.active {
            background: var(--primary);
            color: #ffffff;
            box-shadow: 0 0 20px var(--primary-glow);
        }

        .tab-content {
            display: none;
            animation: fadeIn 0.4s ease forwards;
        }

        .tab-content.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ==========================================================================
           3. GRIDS & CARDS
           ========================================================================== */
        .offer-grid, .why-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 24px;
            margin-bottom: 40px;
        }

        .offer-card, .why-card {
            background: var(--bg-card);
            border: 1px solid var(--bg-glass-border);
            border-radius: 20px;
            padding: 32px;
            transition: var(--transition-smooth);
            position: relative;
            overflow: hidden;
        }

        .offer-card:hover, .why-card:hover {
            border-color: rgba(99, 102, 241, 0.5);
            transform: translateY(-6px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(99, 102, 241, 0.15);
        }

        .card-graphic {
            width: 52px;
            height: 52px;
            background: rgba(99, 102, 241, 0.1);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 1.4rem;
            margin-bottom: 20px;
            transition: var(--transition-bounce);
        }

        .offer-card:hover .card-graphic {
            transform: scale(1.1) rotate(5deg);
            background: var(--primary);
            color: #ffffff;
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .why-number {
            font-weight: 800;
            font-size: 1.1rem;
            color: var(--accent);
            margin-bottom: 16px;
        }

        .offer-card h3, .why-card h3 {
            font-size: 1.25rem;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .offer-card p, .why-card p {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .highlight-text { color: #ffffff; font-weight: 600; }
        .highlight-secondary { color: var(--accent); font-weight: 600; }

        /* ==========================================================================
           4. NAVBAR SECTION
           ========================================================================== */
        .header-nav {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 48px);
            max-width: 1280px;
            z-index: 1000;
            transition: var(--transition-smooth);
        }

        .nav-glass-panel {
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--bg-glass-border);
            border-radius: 100px;
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: -0.02em;
            text-decoration: none;
            color: var(--text-main, #fff);
            transition: var(--transition-fast);
        }

        .brand-logo:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }

        .brand-logo-img {
            height: 36px;
            width: auto;
            border-radius: 6px;
            background: #fff;
            padding: 4px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 32px;
        }

        .nav-link {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-muted);
            transition: var(--transition-fast);
            text-decoration: none;
            position: relative;
            padding: 4px 0;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--primary);
            transition: var(--transition-smooth);
            border-radius: 2px;
        }

        .nav-link:hover {
            color: var(--text-main);
        }

        .nav-link:hover::after {
            width: 100%;
        }

        /* Active State on Navbar */
        .nav-link.active {
            color: #ffffff;
            font-weight: 600;
        }

        .nav-link.active::after {
            width: 100%;
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
        }

        .btn-glow {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            border-radius: 100px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #000;
            font-weight: 700;
            font-size: 0.875rem;
            transition: var(--transition-bounce);
            box-shadow: 0 0 20px var(--primary-glow);
            border: none;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-glow:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 0 35px var(--primary-glow), 0 0 15px var(--accent-glow);
        }

        .mobile-bottom-appbar {
            display: none;
        }

        /* Mobile Bottom Nav */
        @media (max-width: 767px) {
            body {
                padding-bottom: 70px;
            }

            .header-nav {
                top: 12px;
                width: calc(100% - 24px);
            }

            .nav-glass-panel {
                padding: 8px 16px;
            }

            .header-nav .nav-links {
                display: none !important;
            }

            .mobile-bottom-appbar {
                display: block;
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100vw;
                z-index: 10000;
                background: var(--bg-glass, rgba(12, 12, 15, 0.92));
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-top: 1px solid var(--bg-glass-border, rgba(255, 255, 255, 0.1));
                box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.5);
                padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
            }

            .mobile-app-nav-links {
                display: flex;
                align-items: center;
                justify-content: space-around;
                width: 100%;
            }

            .mobile-app-link {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 3px;
                color: var(--text-muted, rgba(255, 255, 255, 0.6));
                text-decoration: none;
                font-size: 0.65rem;
                font-weight: 500;
                flex: 1;
                text-align: center;
                transition: var(--transition-fast);
            }

            .mobile-app-link i {
                font-size: 1.2rem;
            }

            .mobile-app-link:hover,
            .mobile-app-link.active {
                color: var(--accent);
            }
        }

        /* ==========================================================================
           5. FIXED FOOTER SECTION
           ========================================================================== */
        footer {
            background: var(--bg-glass);
            border-top: 1px solid var(--bg-glass-border);
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            padding: 50px 0 25px;
            margin-top: auto; /* Fixed Extra Bottom Gap */
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            position: relative;
            z-index: 10;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 40px;
            margin-bottom: 30px;
        }

        .footer-brand .brand-logo {
            margin-bottom: 12px;
        }

        .footer-bio {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 18px;
            line-height: 1.6;
        }

        .footer-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.25);
            color: var(--accent);
            padding: 6px 14px;
            border-radius: 100px;
            font-size: 0.8rem;
            font-weight: 600;
            transition: var(--transition-fast);
        }

        .footer-status-pill:hover {
            background: rgba(16, 185, 129, 0.15);
            border-color: var(--accent);
            box-shadow: 0 0 15px rgba(16, 185, 129, 0.2);
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent);
        }

        .footer-title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: #ffffff;
            letter-spacing: -0.01em;
        }

        .footer-links {
            list-style: none;
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.9rem;
            transition: var(--transition-fast);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .footer-links a:hover {
            color: #ffffff;
            transform: translateX(6px);
        }

        .footer-links a i {
            font-size: 0.8rem;
            transition: var(--transition-fast);
        }

        .footer-links a:hover i {
            color: var(--accent);
        }

        .footer-social-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .social-badge {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            padding: 8px 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--bg-glass-border);
            border-radius: 10px;
            transition: var(--transition-fast);
        }

        .social-badge:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            border-color: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .social-badge i {
            transition: var(--transition-fast);
        }

        .social-badge:hover i {
            color: var(--primary);
            transform: scale(1.15);
        }

        .action-desc {
            color: var(--text-muted);
            font-size: 0.88rem;
            line-height: 1.5;
            margin-bottom: 14px;
        }

        .btn-whatsapp-glow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: #25d366;
            color: #000000;
            padding: 10px 20px;
            border-radius: 100px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.88rem;
            transition: var(--transition-bounce);
            box-shadow: 0 0 15px rgba(37, 211, 102, 0.3);
            width: 100%;
        }

        .btn-whatsapp-glow:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 0 25px rgba(37, 211, 102, 0.6);
            background: #28e16d;
        }

        .footer-divider {
            height: 1px;
            background: var(--bg-glass-border);
            margin: 25px 0;
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .back-to-top {
            width: 38px;
            height: 38px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: var(--transition-fast);
        }

        .back-to-top:hover {
            background: var(--primary);
            color: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 0 15px var(--primary-glow);
            border-color: var(--primary);
        }

        /* Footer Responsive */
        @media (max-width: 992px) {
            .footer-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 30px;
            }
        }

        @media (max-width: 576px) {
            .footer-grid {
                grid-template-columns: 1fr;
            }
            .footer-bottom {
                flex-direction: column;
                gap: 16px;
                text-align: center;
            }
            .page-header h1 {
                font-size: 2rem;
            }
        }

        /* Modal Overlay */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 20000;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-container {
            background: var(--bg-card);
            border: 1px solid var(--bg-glass-border);
            padding: 24px;
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            position: relative;
        }

        .modal-close {
            position: absolute;
            top: 16px;
            right: 16px;
            background: none;
            border: none;
            color: #fff;
            font-size: 1.2rem;
            cursor: pointer;
        }

        .modal-img {
            width: 100%;
            border-radius: 8px;
            margin-bottom: 16px;
        }
    </style>
</head>
<body>

    <!-- Ambient Glow Tracker -->
    <div class="cursor-glow" id="cursorGlow"></div>

    <!-- 1. NAVBAR SECTION -->
    <header class="header-nav">
        <div class="nav-glass-panel">
            <a href="/" class="brand-logo">
                <img src="/images/logo2.png" style="background-color: var(--accent);" alt="Haidar Ali Logo" class="brand-logo-img" onerror="this.src='https://via.placeholder.com/120x40/10b981/000000?text=HAIDAR'">
                <span style="margin-left: -10px;">aidar Ali</span>
            </a>
            
            <nav class="nav-links">
                <a href="/" class="nav-link">About</a>
