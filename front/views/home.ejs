        .page-header h1 {
            font-size: 3rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 18px;
            color: #ffffff;
        }

        .gradient-text {
            background: linear-gradient(135deg, #a5b4fc, var(--primary), var(--accent));
           
            -webkit-text-fill-color: transparent;
        }

        .page-header p {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* Zigzag Wrapper Setup */
        .workflow-section {
            position: relative;
            padding: 20px 0;
        }

        .zigzag-wrapper {
            position: relative;
            max-width: 1050px;
            margin: 0 auto;
        }

        /* Vertical Center Line Background */
        .zigzag-line-bg {
            position: absolute;
            top: 25px;
            bottom: 25px;
            left: 50%;
            width: 3px;
            background: rgba(255, 255, 255, 0.08);
            transform: translateX(-50%);
            z-index: 1;
        }

        .zigzag-line-fill {
            position: absolute;
            top: 25px;
            bottom: 25px;
            left: 50%;
            width: 3px;
            background: linear-gradient(180deg, var(--primary) 0%, var(--accent) 100%);
            transform: translateX(-50%);
            z-index: 1;
            box-shadow: 0 0 12px var(--primary-glow);
        }

        /* Zigzag Card Container */
        .zigzag-item {
            position: relative;
            display: flex;
            align-items: center;
            margin-bottom: 60px;
            width: 100%;
        }

        .zigzag-item:last-child {
            margin-bottom: 0;
        }

        .zigzag-item.left {
            justify-content: flex-start;
        }

        .zigzag-item.right {
            justify-content: flex-end;
        }

        /* Central Node Icon */
        .zigzag-node {
            position: absolute;
            left: 50%;
            top: 30px;
            transform: translateX(-50%);
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #0d0e12;
            border: 2px solid var(--primary);
            color: #ffffff;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 3;
            box-shadow: 0 0 20px var(--primary-glow);
            transition: var(--transition-bounce);
        }

        .zigzag-item:nth-child(even) .zigzag-node {
            border-color: var(--accent);
            box-shadow: 0 0 20px var(--accent-glow);
            color: var(--accent);
        }

        .zigzag-item:hover .zigzag-node {
            transform: translateX(-50%) scale(1.15);
        }

        /* Card Styling */
        .zigzag-card {
            width: 44%;
            background: var(--bg-card);
            border: 1px solid var(--bg-glass-border);
            border-radius: 20px;
            padding: 28px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            transition: var(--transition-smooth);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
            position: relative;
            overflow: hidden;
        }

        .zigzag-card:hover {
            transform: translateY(-6px);
            border-color: rgba(255, 255, 255, 0.2);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
        }

        .card-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .step-num {
            font-size: 1.4rem;
            font-weight: 800;
            color: rgba(255, 255, 255, 0.25);
            line-height: 1;
        }

        .step-badge {
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 100px;
            background: rgba(99, 102, 241, 0.15);
            color: #a5b4fc;
            border: 1px solid rgba(99, 102, 241, 0.3);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .zigzag-item:nth-child(even) .step-badge {
            background: rgba(16, 185, 129, 0.15);
            color: #6ee7b7;
            border-color: rgba(16, 185, 129, 0.3);
        }

        .zigzag-card h3 {
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 12px;
            line-height: 1.35;
        }

        .zigzag-card p {
            color: var(--text-muted);
            font-size: 0.92rem;
            line-height: 1.6;
            margin-bottom: 16px;
        }

        /* Feature Tags */
        .feature-tags, .tech-logos {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 14px;
        }

        .tag-pill {
            font-size: 0.78rem;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: rgba(255, 255, 255, 0.85);
            transition: var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .tag-pill:hover {
            background: rgba(255, 255, 255, 0.09);
            border-color: rgba(255, 255, 255, 0.2);
            color: #ffffff;
        }

        .tag-pill i {
            color: var(--accent);
            font-size: 0.75rem;
        }

        /* Added Graphic Banner inside Cards */
        .card-graphic-banner {
            width: 100%;
            height: 120px;
            border-radius: 12px;
            object-fit: cover;
            margin-bottom: 18px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            filter: brightness(0.9) contrast(1.05);
            transition: var(--transition-smooth);
        }

        .zigzag-card:hover .card-graphic-banner {
            filter: brightness(1) contrast(1.1);
            transform: scale(1.01);
        }

        .tech-icon-brand {
            height: 18px;
            width: auto;
            vertical-align: middle;
        }

        /* Responsive Layout adjustments */
        @media (max-width: 868px) {
            .page-header h1 {
                font-size: 2.2rem;
            }

            .zigzag-line-bg, .zigzag-line-fill {
                left: 26px;
            }

            .zigzag-item {
                flex-direction: column;
                align-items: flex-start;
                margin-bottom: 40px;
            }

            .zigzag-node {
                left: 26px;
                top: 0;
            }

            .zigzag-card {
                width: calc(100% - 64px);
                margin-left: 64px !important;
            }

            .zigzag-item.left, .zigzag-item.right {
                justify-content: flex-start;
            }
        }

