<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haider Ali portfolio</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
        :root {
            --bg-deep: #050811;
            --bg-surface: rgba(15, 23, 42, 0.65);
            --bg-card: rgba(30, 41, 59, 0.7);
            --bg-card-hover: rgba(51, 65, 85, 0.85);
            
            --neon-green: #10b981;
            --neon-cyan: #06b6d4;
            --neon-purple: #a855f7;
            
            --text-white: #f8fafc;
            --text-muted: #94a3b8;
            --border-line: rgba(255, 255, 255, 0.08);
            
            --main-gradient: linear-gradient(135deg, #10b981 0%, #06b6d4 50%, #a855f7 100%);
            --glow-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; scroll-behavior: smooth; }
        h1, h2, h3, h4, .logo, .stat-num, .slogan-tag { font-family: 'Space Grotesk', sans-serif; }
        
        body { 
            background-color: var(--bg-deep); 
            color: var(--text-white); 
            overflow-x: hidden; 
            line-height: 1.6;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(16, 185, 129, 0.08) 0%, transparent 45%),
                radial-gradient(circle at 85% 60%, rgba(168, 85, 247, 0.08) 0%, transparent 45%),
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
            background-attachment: fixed;
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

        /* --- Header --- */
        header { 
            position: sticky; 
            top: 0; 
            background: rgba(5, 8, 17, 0.85); 
            backdrop-filter: blur(20px); 
            border-bottom: 1px solid var(--border-line); 
            z-index: 1000; 
            padding: 16px 0; 
        }
        .nav-box { display: flex; justify-content: space-between; align-items: center; }
        
        .logo { 
            font-size: 1.6rem; 
            font-weight: 700; 
            text-decoration: none; 
        }

        .nav-menu { display: flex; gap: 28px; list-style: none; align-items: center; }
        .nav-item { position: relative; }
        .nav-link { color: var(--text-muted); text-decoration: none; font-weight: 500; font-size: 0.95rem; transition: 0.3s; }
        .nav-link:hover, .nav-link.active { color: #fff; }

        /* Dropdown */
        .dropdown { position: absolute; top: 120%; left: 0; background: var(--bg-card); backdrop-filter: blur(15px); border: 1px solid var(--border-line); border-radius: 12px; min-width: 200px; padding: 8px 0; opacity: 0; visibility: hidden; transform: translateY(10px); transition: all 0.3s ease; }
        .nav-item:hover .dropdown { opacity: 1; visibility: visible; transform: translateY(0); }
        .dropdown a { display: block; padding: 10px 20px; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; }
        .dropdown a:hover { background: var(--bg-card-hover); color: var(--neon-cyan); }

        .btn-enquiry { background: var(--main-gradient); color: #000; padding: 10px 24px; border-radius: 30px; font-weight: 700; text-decoration: none; font-size: 0.9rem; transition: 0.3s; border: none; display: inline-flex; align-items: center; gap: 8px; cursor: pointer;}
        .btn-enquiry:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(6, 182, 212, 0.45); }
        .menu-toggle { display: none; color: #fff; font-size: 1.5rem; cursor: pointer; }

        /* --- Hero --- */
        .hero { display: flex; align-items: center; gap: 50px; padding: 70px 0 50px; }
        .hero-left { flex: 1; display: flex; justify-content: center;  }
        .avatar-ring { position: relative; width: 270px; height: 270px; border-radius: 50%; padding: 4px; background: var(--main-gradient); box-shadow: 0 0 30px rgba(16, 185, 129, 0.3); }
        .avatar-img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; background: var(--bg-surface); }
        
        .hero-right { flex: 1.5; }
        .status-badge { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: var(--neon-green); padding: 5px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 15px; }
        .slogan-tag { font-size: 1rem; color: var(--neon-cyan); font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px; display: block; }
        
        .hero-right h1 { font-size: 3rem; line-height: 1.15; font-weight: 700; margin-bottom: 16px; color: var(--text-white); }
        .hero-right p { color: var(--text-muted); font-size: 1rem; margin-bottom: 24px; }

        .social-links { display: flex; gap: 12px; margin-bottom: 25px; }
        .social-btn { width: 40px; height: 40px; border-radius: 12px; background: var(--bg-card); border: 1px solid var(--border-line); display: flex; align-items: center; justify-content: center; color: var(--text-muted); text-decoration: none; transition: 0.3s; }
        .social-btn:hover { background: var(--neon-green); color: #000; transform: translateY(-3px); }

        /* --- Stats Bar --- */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 15px; background: var(--bg-surface); border: 1px solid var(--border-line); border-radius: 16px; padding: 25px; margin-bottom: 60px; }
        .stat-box { text-align: center; }
        .stat-label { color: var(--text-muted); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; margin-top: 5px; }

        .section-header { text-align: center; margin-bottom: 35px; }
        .section-header h2 { font-size: 2rem; font-weight: 700; }
        .section-header p { color: var(--text-muted); font-size: 0.95rem; }

        /* --- Resume Banner --- */
        .resume-banner { background: var(--bg-card); border: 1px solid var(--border-line); border-radius: 20px; padding: 30px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; margin-bottom: 60px; }
        .resume-info h3 { font-size: 1.4rem; color: #fff; margin-bottom: 4px; }
        .resume-info p { color: var(--text-muted); font-size: 0.9rem; }

        /* --- 3D COVERFLOW SWIPER CAROUSEL STYLES --- */
        .cert-carousel-wrapper {
            position: relative;
            padding: 40px 0;
            margin-bottom: 60px;
            overflow: hidden;
        }

        .cert-swiper {
            width: 100%;
            padding-top: 20px;
            padding-bottom: 40px;
        }

        .swiper-slide {
            width: 310px;
            height: auto;
            transition: all 0.4s ease;
        }

        .cert-card {
            background: var(--bg-card);
            border: 1px solid var(--border-line);
            border-radius: 18px;
            padding: 16px;
            text-align: center;
            cursor: pointer;
            backdrop-filter: blur(10px);
            transition: all 0.4s ease;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            opacity: 0.4; /* Non-active slides blurred/faded like image */
            filter: grayscale(40%);
        }

        /* Active / Center Slide Styling */
        .swiper-slide-active .cert-card {
            opacity: 1;
            filter: grayscale(0%);
            border-color: var(--neon-cyan);
            box-shadow: 0 0 30px rgba(6, 182, 212, 0.3);
            transform: scale(1.08); /* Center card is larger */
        }

        .cert-img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 15px;
        }

        .cert-card h4 {
            font-size: 1.1rem;
            color: #fff;
            margin-bottom: 6px;
        }

        .cert-card p {
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        /* Nav Buttons Positioning */
        .carousel-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 45px;
            height: 45px;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid var(--border-line);
            color: var(--text-white);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: 0.3s;
        }

        .carousel-btn:hover {
            background: var(--neon-cyan);
            color: #000;
            box-shadow: 0 0 15px rgba(6, 182, 212, 0.5);
        }

        .carousel-btn.prev { left: 10px; }
        .carousel-btn.next { right: 10px; }

        /* Modal Overlay */
        .cert-modal {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(5, 8, 17, 0.9);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: 0.3s ease;
            z-index: 2000;
        }

        .cert-modal.active {
            opacity: 1;
            visibility: visible;
        }

        .cert-modal-content {
            background: var(--bg-card);
            border: 1px solid var(--border-line);
            border-radius: 20px;
            padding: 24px;
            max-width: 550px;
            width: 90%;
            text-align: center;
            position: relative;
        }

        .cert-modal-content img {
            width: 100%;
            max-height: 350px;
            object-fit: contain;
            border-radius: 12px;
            margin-bottom: 15px;
        }

        .cert-modal-close {
            position: absolute;
            top: 15px;
            right: 20px;
            font-size: 1.8rem;
            color: var(--text-muted);
            background: none;
            border: none;
            cursor: pointer;
        }

        .cert-modal-close:hover { color: #fff; }

        /* --- Tech Toolkit --- */
        .skills-box { background: var(--bg-surface); border: 1px solid var(--border-line); border-radius: 20px; padding: 30px; margin-bottom: 70px; }
        .skills-wrap { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
        .skill-tag { background: var(--bg-card); border: 1px solid var(--border-line); color: var(--text-white); padding: 8px 18px; border-radius: 25px; font-size: 0.88rem; font-weight: 600; display: flex; align-items: center; gap: 8px; }

        /* --- COMPACT CLIENT PROJECTS --- */
        .projects-compact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-bottom: 25px; }
        .project-micro-card { background: var(--bg-card); border: 1px solid var(--border-line); border-radius: 14px; padding: 14px; transition: 0.3s; text-decoration: none; color: #fff; display: block; }
        .project-micro-card:hover { border-color: var(--neon-purple); transform: translateY(-4px); }
        .project-micro-img { width: 100%; height: 130px; object-fit: cover; border-radius: 8px; margin-bottom: 10px; }
        .project-micro-card h4 { font-size: 1rem; margin-bottom: 4px; }
        .project-micro-card p { color: var(--text-muted); font-size: 0.82rem; }

        .view-more-container { text-align: center; margin-bottom: 70px; }
        .btn-view-more { display: inline-flex; align-items: center; gap: 8px; color: var(--neon-cyan); border: 1px solid var(--neon-cyan); padding: 9px 24px; border-radius: 25px; text-decoration: none; font-weight: 600; font-size: 0.88rem; transition: 0.3s; }
        .btn-view-more:hover { background: var(--neon-cyan); color: #000; }

        /* --- Developer Profiles Section --- */
        .dev-profiles-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 70px; }
        .profile-card { background: var(--bg-card); border: 1px solid var(--border-line); border-radius: 14px; padding: 20px; text-align: center; transition: 0.3s; text-decoration: none; color: var(--text-white); }
        .profile-card:hover { border-color: var(--neon-green); transform: translateY(-4px); }
        .profile-icon { font-size: 2.2rem; margin-bottom: 10px; }

        /* --- Enquiry / Contact Section --- */
        .enquiry-section { background: var(--bg-surface); border: 1px solid var(--border-line); border-radius: 20px; padding: 40px 24px; margin-bottom: 70px; text-align: center; }
        .enquiry-section h2 { font-size: 2rem; margin-bottom: 8px; }
        .enquiry-section p { color: var(--text-muted); max-width: 550px; margin: 0 auto 24px; font-size: 0.95rem; }

        .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-top: 25px; }
        .contact-card { padding: 16px; background: var(--bg-card); border-radius: 12px; border: 1px solid var(--border-line); }
        .contact-card i { font-size: 1.5rem; color: var(--neon-cyan); margin-bottom: 8px; }
        .contact-card a, .contact-card p { color: var(--text-muted); text-decoration: none; font-size: 0.85rem; }

        /* --- FOOTER STYLING --- */
        footer { 
            background: #020408; 
            border-top: 1px solid var(--border-line); 
            padding: 60px 0 25px; 
            color: var(--text-muted); 
            font-size: 0.9rem;
            position: relative;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 40px;
            margin-bottom: 45px;
        }
        .footer-brand p {
            margin-top: 12px;
            font-size: 0.88rem;
            max-width: 300px;
            line-height: 1.6;
        }
        .footer-title {
            color: var(--text-white);
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 18px;
        }
        .footer-links { list-style: none; }
        .footer-links li { margin-bottom: 10px; }
        .footer-links a { color: var(--text-muted); text-decoration: none; transition: 0.3s; }
        .footer-links a:hover { color: var(--neon-green); padding-left: 4px; }
        
        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }
        .back-to-top {
            width: 38px;
            height: 38px;
            background: var(--bg-card);
            border: 1px solid var(--border-line);
            color: var(--neon-cyan);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: 0.3s;
        }
        .back-to-top:hover {
            background: var(--neon-cyan);
            color: #000;
            transform: translateY(-3px);
        }

        @media (max-width: 992px) {
            .hero { flex-direction: column; text-align: center; }
            .hero-actions, .social-links { justify-content: center; }
            .footer-grid { grid-template-columns: 1fr 1fr; gap: 30px; }
        }

        @media (max-width: 768px) {
            .nav-menu { display: none; flex-direction: column; position: absolute; top: 100%; left: 0; width: 100%; background: var(--bg-deep); padding: 20px; border-bottom: 1px solid var(--border-line); }
            .nav-menu.active { display: flex; }
            .menu-toggle { display: block; }
            .hero-right h1 { font-size: 2.2rem; }
            .footer-grid { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column; text-align: center; }
            .swiper-slide { width: 260px; }
        }

        .card-img-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 10px;
}

.live-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(5, 8, 17, 0.85);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: var(--neon-green);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    gap: 5px;
    z-index: 2;
}

.live-badge i {
    font-size: 0.5rem;
    animation: pulse 1.5s infinite;
}

.project-micro-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
    display: block;
    transition: transform 0.4s ease;
}

.project-micro-card:hover .project-micro-img {
    transform: scale(1.04);
}

.card-body {
    padding-top: 12px;
}

.card-tech-stack {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin: 10px 0 12px;
}

.card-tech-stack span {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-line);
    color: var(--text-muted);
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 6px;
}

.card-footer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--neon-cyan);
    font-size: 0.82rem;
    font-weight: 600;
    border-top: 1px solid var(--border-line);
    padding-top: 8px;
}

@keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.3; }
    100% { opacity: 1; }
}
    </style>
</head>
