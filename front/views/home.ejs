            text-align: center;
            max-width: 800px;
            margin: 10px auto 70px;
        }

        .slogan-tag {
            display: inline-block;
            padding: 6px 18px;
            background: rgba(99, 102, 241, 0.1);
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 100px;
            color: var(--primary);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 18px;
