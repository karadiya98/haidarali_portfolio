<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Haidar Ali — Full-Stack & Android Systems Engineer</title>
    
    <meta name="description" content="Portfolio of Haidar Ali — Full-Stack MERN & Android Engineer crafting scalable web applications, real-time GPS tracking systems, and high-performance custom software solutions.">
    <meta name="keywords" content="Haidar Ali, Full Stack Developer, MERN, Android, Java, Vadodara Developer, Node.js, React">
    <meta name="author" content="Haidar Ali">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome Pro 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        /* ==========================================================================
           1. CORE ENGINE & THEME CONSTANTS
           ========================================================================== */
        :root {
            --bg-base: #030712;
              --bg-dark: #08080a;
            --bg-surface: #0b0f19;
            --bg-surface-elevated: #111827;
            --bg-glass: rgba(17, 24, 39, 0.75);
            --bg-glass-border: rgba(255, 255, 255, 0.08);
            --bg-glass-hover: rgba(255, 255, 255, 0.12);
            
            --primary: #06b6d4;
            --primary-glow: rgba(6, 182, 212, 0.35);
            --accent: #10b981;
            --accent-glow: rgba(16, 185, 129, 0.35);
            --purple: #a855f7;
            --purple-glow: rgba(168, 85, 247, 0.35);
            --amber: #f59e0b;
            
            --text-main: #f9fafb;
            --text-muted: #9ca3af;
            --text-subtle: #6b7280;
            
            --border-light: rgba(255, 255, 255, 0.06);
            --border-focus: rgba(6, 182, 212, 0.5);
            
            --radius-sm: 8px;
            --radius-md: 16px;
            --radius-lg: 24px;
            --radius-xl: 32px;
            
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            
            --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            --transition-smooth: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            --transition-bounce: 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
            
            --shadow-subtle: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }

        /* ==========================================================================
           2. GLOBAL RESET & BASE STYLES
           ========================================================================== */
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            color-scheme: dark;
            background-color: var(--bg-base);
            font-family: var(--font-sans);
            text-rendering: optimizeLegibility;
            -webkit-font-smoothing: antialiased;
        }
 body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
            padding-top: 110px;
            padding-bottom: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .cursor-glow {
            position: fixed;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(6, 182, 212, 0.08) 0%, rgba(16, 185, 129, 0) 70%);
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 0;
            transition: left 0.1s ease-out, top 0.1s ease-out;
        }

        a { color: inherit; text-decoration: none; }
        ul { list-style: none; }
        img { max-width: 100%; display: block; }

        .container {
            width: 100%;
            max-width: 1360px;
            margin: 0 auto;
            padding: 0 24px;
            position: relative;
            z-index: 2;
        }

        section {
            padding: 100px 0;
            position: relative;
        }

        .section-header {
            text-align: center;
            max-width: 720px;
            margin: 0 auto 64px auto;
        }

        .section-header .tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px;
            border-radius: 100px;
            background: rgba(6, 182, 212, 0.08);
            border: 1px solid rgba(6, 182, 212, 0.2);
            color: var(--primary);
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .section-header h2 {
            font-size: clamp(2rem, 3.5vw, 2.8rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, #ffffff 30%, var(--text-muted) 100%);
            
            -webkit-text-fill-color: transparent;
            margin-bottom: 16px;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 1.05rem;
            line-height: 1.7;
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-base); }
        ::-webkit-scrollbar-thumb { background: #1f293d; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--primary); }

        /* ==========================================================================
           2. NAVBAR SECTION
           ========================================================================== */
        .header-nav {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 48px);
            max-width: 1280px;
            z-index: 1000;
            transition: var(--transition-smooth);
        }

        .nav-glass-panel {
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--bg-glass-border);
            border-radius: 100px;
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: -0.02em;
            text-decoration: none;
            color: var(--text-main);
            transition: var(--transition-fast);
        }

        .brand-logo:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }

        .brand-logo-img {
            height: 36px;
            width: auto;
            border-radius: 6px;
            background: #fff;
            padding: 4px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 32px;
        }

        .nav-link {
            font-size: 0.9rem;
            font-weight: 500;
            color: var(--text-muted);
            transition: var(--transition-fast);
            text-decoration: none;
            position: relative;
            padding: 4px 0;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0%;
            height: 2px;
            background: var(--primary);
            transition: var(--transition-smooth);
            border-radius: 2px;
        }

        .nav-link:hover {
            color: var(--text-main);
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .nav-link.active {
            color: #ffffff;
            font-weight: 600;
        }

        .nav-link.active::after {
            width: 100%;
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
        }

        .btn-glow {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 22px;
            border-radius: 100px;
            background: linear-gradient(135deg, var(--primary), var(--accent));
            color: #000;
            font-weight: 700;
            font-size: 0.875rem;
            transition: var(--transition-bounce);
            box-shadow: 0 0 20px var(--primary-glow);
            border: none;
            cursor: pointer;
            text-decoration: none;
        }

        .btn-glow:hover {
            transform: translateY(-2px) scale(1.03);
            box-shadow: 0 0 35px var(--primary-glow), 0 0 15px var(--accent-glow);
        }

        .mobile-bottom-appbar {
            display: none;
        }

        @media (max-width: 767px) {
            body {
                padding-bottom: 70px;
            }

            .header-nav {
                top: 12px;
                width: calc(100% - 24px);
            }

            .nav-glass-panel {
                padding: 8px 16px;
            }

            .header-nav .nav-links {
                display: none !important;
            }

            .mobile-bottom-appbar {
                display: block;
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100vw;
                z-index: 10000;
                background: var(--bg-glass);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-top: 1px solid var(--bg-glass-border);
                box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.5);
                padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
            }

            .mobile-app-nav-links {
                display: flex;
                align-items: center;
                justify-content: space-around;
                width: 100%;
            }

            .mobile-app-link {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 3px;
                color: var(--text-muted);
                text-decoration: none;
                font-size: 0.65rem;
                font-weight: 500;
                flex: 1;
                text-align: center;
                transition: var(--transition-fast);
            }

            .mobile-app-link i {
                font-size: 1.2rem;
            }

            .mobile-app-link:hover,
            .mobile-app-link.active {
                color: var(--accent);
            }
        }

        /* ==========================================================================
           4. HERO SECTION (PROFILE PHOTO + ABOUT ME)
           ========================================================================== */
        .hero-section {
            padding-top: 170px;
            padding-bottom: 60px;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 0.85fr 1.15fr;
            align-items: center;
            gap: 56px;
        }

        .dev-photo-card {
            position: relative;
            background: var(--bg-surface);
            border: 1px  var(--bg-glass-border);
            border-radius: var(--radius-xl);
            padding: 15px;
            
            box-shadow: var(--shadow-subtle), 0 0 60px rgba(6, 182, 212, 0.08);
            transition: var(--transition-smooth);
        }

        .dev-photo-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-focus);
        }

        .photo-wrapper {
            position: relative;
            width: 100%;
            height: 420px;
            border-radius: var(--radius-lg);
            overflow: hidden;
            background: var(--bg-surface-elevated);
        }

        .dev-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
            transition: transform 0.6s ease;
        }

        .dev-photo-card:hover .dev-img {
            transform: scale(1.04);
        }

        .photo-info-overlay {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            padding: 24px;
            background: linear-gradient(180deg, transparent 0%, rgba(3, 7, 18, 0.95) 100%);
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
        }

        .photo-info-overlay h3 { font-size: 1.3rem; font-weight: 700; }
        .photo-info-overlay p { font-size: 0.85rem; color: var(--primary); font-family: var(--font-mono); }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 18px;
            border-radius: 100px;
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.2);
            color: var(--accent);
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 24px;
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 10px var(--accent);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        .hero-title {
            font-size: clamp(2.4rem, 4vw, 3.6rem);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.03em;
            margin-bottom: 20px;
        }

        .gradient-text {
            background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 50%, var(--purple) 100%);
            
            -webkit-text-fill-color: transparent;
        }

        .hero-about-text {
            font-size: 1.1rem;
            color: var(--text-muted);
            line-height: 1.75;
            margin-bottom: 36px;
        }

        .hero-cta-group {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-wrap: wrap;
        }

        .btn-secondary-glass {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 28px;
            border-radius: 100px;
            background: var(--bg-glass);
            border: 1px solid var(--bg-glass-border);
            color: var(--text-main);
            font-weight: 600;
            transition: var(--transition-smooth);
        }

        .btn-secondary-glass:hover {
            background: var(--bg-glass-hover);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }

        /* ==========================================================================
           5. METRICS / NUMBERS STATS SECTION
           ========================================================================== */
        .stats-section {
            padding: 40px 0 80px 0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .stat-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-lg);
            padding: 32px 24px;
            text-align: center;
            position: relative;
            overflow: hidden;
            transition: var(--transition-smooth);
        }

        .stat-card:hover {
            transform: translateY(-6px);
            border-color: var(--primary);
            box-shadow: 0 15px 35px -10px var(--primary-glow);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            opacity: 0;
            transition: var(--transition-fast);
        }

        .stat-card:hover::before { opacity: 1; }

        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            font-family: var(--font-mono);
            background: linear-gradient(135deg, #fff, var(--text-muted));
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            line-height: 1;
        }
a
        .stat-label {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* ==========================================================================
           6. TECHNICAL SKILLS SECTION
           ========================================================================== */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .skill-group-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-lg);
            padding: 32px;
            transition: var(--transition-smooth);
        }

        .skill-group-card:hover {
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-4px);
        }

        .skill-group-title {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 24px;
            color: var(--text-main);
        }

        .skill-group-title i {
            color: var(--primary);
            font-size: 1.3rem;
        }

        .skills-badge-list {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .skill-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border-light);
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-main);
            transition: var(--transition-fast);
        }

        .skill-badge:hover {
            border-color: var(--primary);
            background: rgba(6, 182, 212, 0.1);
            color: var(--primary);
            transform: translateY(-2px);
        }

        .skill-badge i { font-size: 1rem; }

        /* ==========================================================================
           7. CERTIFICATES HORIZONTAL AUTO-SCROLL CAROUSEL
           ========================================================================== */
        .certificates-section {
            background: var(--bg-surface);
            border-top: 1px solid var(--border-light);
            border-bottom: 1px solid var(--border-light);
            overflow: hidden;
        }

        .marquee-container {
            width: 100%;
            overflow: hidden;
            position: relative;
            mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
            -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
        }

        .marquee-track {
            display: flex;
            gap: 28px;
            width: max-content;
            animation: infiniteScroll 25s linear infinite;
        }

        .marquee-container:hover .marquee-track {
            animation-play-state: paused;
        }

        @keyframes infiniteScroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        .cert-card {
            width: 320px;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-md);
            padding: 16px;
            cursor: pointer;
            transition: var(--transition-smooth);
            flex-shrink: 0;
        }

        .cert-card:hover {
            transform: translateY(-4px);
            border-color: var(--primary);
            box-shadow: 0 10px 25px -5px var(--primary-glow);
        }

        .cert-img-wrapper {
            width: 100%;
            height: 180px;
            border-radius: var(--radius-sm);
            overflow: hidden;
            margin-bottom: 14px;
            background: var(--bg-base);
        }

        .cert-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .cert-card h4 {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cert-card p {
            font-size: 0.8rem;
            color: var(--text-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* ==========================================================================
           8. CLIENT 4 WORKS (EXACT 4-COLUMN SINGLE ROW GRID)
           ========================================================================== */
        .projects-4col-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .project-micro-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-md);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: var(--transition-smooth);
            text-decoration: none;
            color: inherit;
            height: 100%;
        }

        .project-micro-card:hover {
            transform: translateY(-8px);
            border-color: rgba(6, 182, 212, 0.5);
            box-shadow: 0 20px 40px -15px rgba(0,0,0,0.8), 0 0 25px var(--primary-glow);
        }

        .card-img-wrapper {
            position: relative;
            width: 100%;
            height: 160px;
            overflow: hidden;
            background: var(--bg-surface-elevated);
        }

        .project-micro-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .project-micro-card:hover .project-micro-img {
            transform: scale(1.08);
        }

        .live-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(3, 7, 18, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 3px 10px;
            border-radius: 100px;
            font-size: 0.7rem;
            font-weight: 600;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 6px;
            z-index: 2;
        }

        .live-badge i { font-size: 0.45rem; color: var(--accent); }

        .card-body {
            padding: 18px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .card-body h4 {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: var(--text-main);
            transition: var(--transition-fast);
        }

        .project-micro-card:hover .card-body h4 { color: var(--primary); }

        .card-body p {
            font-size: 0.825rem;
            color: var(--text-muted);
            margin-bottom: 16px;
            line-height: 1.5;
            flex-grow: 1;
        }

        .card-tech-stack {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 16px;
        }

        .card-tech-stack span {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            padding: 3px 8px;
            border-radius: 4px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border-light);
            color: var(--primary);
        }

        .card-footer-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 12px;
            border-top: 1px solid var(--border-light);
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-subtle);
        }

        .project-micro-card:hover .card-footer-link { color: var(--text-main); }

        .view-more-container {
            text-align: center;
            margin-top: 52px;
        }

        .btn-view-more {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 32px;
            border-radius: 100px;
            background: var(--bg-glass);
            border: 1px solid var(--bg-glass-border);
            color: var(--text-main);
            font-weight: 700;
            transition: var(--transition-smooth);
        }

        .btn-view-more:hover {
            background: var(--primary);
            color: #000;
            box-shadow: 0 0 30px var(--primary-glow);
            transform: translateY(-2px);
        }

        /* ==========================================================================
           9. SOCIAL & PROFESSIONAL LINKS SECTION
           ========================================================================== */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .social-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-lg);
            padding: 32px;
            text-align: center;
            transition: var(--transition-smooth);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .social-card:hover {
            transform: translateY(-6px);
            border-color: var(--primary);
            box-shadow: 0 10px 30px -10px var(--primary-glow);
        }

        .social-icon {
            font-size: 2.5rem;
            margin-bottom: 16px;
            transition: transform 0.4s var(--transition-bounce);
        }

        .social-card:hover .social-icon {
            transform: scale(1.15) rotate(5deg);
        }

        .social-card h4 {
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .social-card p {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        /* ==========================================================================
           10. CREATIVITY SECTION (INTERACTIVE COST ESTIMATOR + TERMINAL)
           ========================================================================== */
        .creativity-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
        }

        .creative-widget-card {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-xl);
            padding: 36px;
            position: relative;
        }

        .widget-title {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Interactive Terminal */
        .terminal-box {
            background: #020617;
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-md);
            padding: 20px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: #38bdf8;
            height: auto;
            overflow-y: auto;
        }

        .terminal-line { margin-bottom: 8px; }
        .terminal-prompt { color: var(--accent); margin-right: 8px; }

        /* Project Cost Estimator Widget */
        .estimator-group {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .estimator-option {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: var(--bg-surface-elevated);
            padding: 12px 20px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-light);
            cursor: pointer;
            transition: var(--transition-fast);
        }

        .estimator-option:hover { border-color: var(--primary); }

        .estimator-option input[type="checkbox"] {
            accent-color: var(--primary);
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .estimator-price-tag {
            font-family: var(--font-mono);
            color: var(--accent);
            font-weight: 700;
        }

        .estimator-total-display {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid var(--border-light);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 800;
            font-size: 1.1rem;
        }

        /* ==========================================================================
           11. DIRECT ENQUIRY & CONTACT SECTION
           ========================================================================== */
        .enquiry-section {
            background: radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.08) 0%, transparent 70%), var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-xl);
            padding: 80px 48px;
            text-align: center;
        }

        .slogan-tag {
            display: inline-block;
            color: var(--primary);
            font-family: var(--font-mono);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 12px;
        }

        .enquiry-section h2 {
            font-size: clamp(2rem, 3.5vw, 2.8rem);
            font-weight: 800;
            margin-bottom: 16px;
        }

        .enquiry-section p {
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto 40px auto;
            font-size: 1.05rem;
        }

        .btn-enquiry {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 16px 36px;
            border-radius: 100px;
            background: #25d366;
            color: #000;
            font-weight: 800;
            font-size: 1rem;
            transition: var(--transition-bounce);
            box-shadow: 0 0 30px rgba(37, 211, 102, 0.3);
            margin-bottom: 56px;
        }

        .btn-enquiry:hover {
            transform: scale(1.05);
            box-shadow: 0 0 50px rgba(37, 211, 102, 0.5);
        }

        .contact-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 24px;
        }

        .contact-card {
            background: var(--bg-glass);
            border: 1px solid var(--bg-glass-border);
            padding: 24px;
            border-radius: var(--radius-md);
            transition: var(--transition-smooth);
        }

        .contact-card:hover {
            background: var(--bg-surface-elevated);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-3px);
        }

        .contact-card i {
            font-size: 1.5rem;
            color: var(--primary);
            margin-bottom: 12px;
        }

        .contact-card p {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-subtle);
            margin-bottom: 4px;
        }

        .contact-card a {
            font-weight: 600;
            color: var(--text-main);
            font-size: 0.95rem;
            word-break: break-all;
        }

        /* ==========================================================================
           12. FOOTER SECTION
           ========================================================================== */
        footer {
            background: var(--bg-surface);
            border-top: 1px solid var(--border-light);
            padding: 80px 0 40px 0;
            margin-top: 100px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 48px;
            margin-bottom: 64px;
        }

        .footer-brand p {
            color: var(--text-muted);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-top: 20px;
            max-width: 320px;
        }

        .footer-logo-badge {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 8px;
            background: #fff !important;
        }

        .footer-logo-img { height: 32px; width: auto; }
        .footer-title { font-size: 1rem; font-weight: 700; margin-bottom: 24px; }

        .footer-links { display: flex; flex-direction: column; gap: 12px; }
        .footer-links a { color: var(--text-muted); font-size: 0.9rem; transition: var(--transition-fast); }
        .footer-links a:hover { color: var(--primary); padding-left: 4px; }

        .footer-bottom {
            padding-top: 32px;
            border-top: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--text-subtle);
            font-size: 0.85rem;
        }

        .back-to-top {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--bg-surface-elevated);
            border: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-main);
            transition: var(--transition-bounce);
        }

        .back-to-top:hover {
            background: var(--primary);
            color: #000;
            transform: translateY(-4px);
        }

        /* ==========================================================================
           13. CERTIFICATE MODAL SYSTEM
           ========================================================================== */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(3, 7, 18, 0.88);
            backdrop-filter: blur(16px);
            z-index: 2000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition-smooth);
        }

        .modal-overlay.active { opacity: 1; pointer-events: auto; }

        .modal-container {
            background: var(--bg-surface);
            border: 1px solid var(--bg-glass-border);
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 650px;
            padding: 32px;
            position: relative;
            transform: scale(0.9);
            transition: var(--transition-bounce);
        }

        .modal-overlay.active .modal-container { transform: scale(1); }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255,255,255,0.05);
            border: none;
            color: var(--text-muted);
            width: 36px; height: 36px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .modal-img {
            width: 100%;
            border-radius: var(--radius-md);
            margin-bottom: 20px;
            max-height: 380px;
            object-fit: cover;
        }

        /* ==========================================================================
           14. RESPONSIVE BREAKPOINTS (PRESERVING 4-COL ON DESKTOP)
           ========================================================================== */
        @media (max-width: 1200px) {
            .projects-4col-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
            .skills-grid { grid-template-columns: repeat(2, 1fr); }
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 992px) {
            .hero-grid { grid-template-columns: 1fr; text-align: center; }
            .hero-about-text { margin-left: auto; margin-right: auto; }
            .hero-cta-group { justify-content: center; }
            .creativity-grid { grid-template-columns: 1fr; }
            .social-grid { grid-template-columns: 1fr; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
        }

        @media (max-width: 640px) {
            .projects-4col-grid { grid-template-columns: 1fr; }
            .skills-grid { grid-template-columns: 1fr; }
            .stats-grid { grid-template-columns: 1fr; }
            .nav-links { display: none; }
            .footer-grid { grid-template-columns: 1fr; }
            .enquiry-section { padding: 48px 24px; }
            section { padding: 70px 0; }
        }

:root {
  --bg-card: rgba(18, 24, 38, 0.75);
  --border-card: rgba(255, 255, 255, 0.08);
  --border-hover: rgba(99, 102, 241, 0.4);
  --accent-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
  --glow-color: rgba(99, 102, 241, 0.25);
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
}

.stats-section {
  padding: 4rem 1.5rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  max-width: 1100px;
  margin: 0 auto;
}

.stat-card {
  position: relative;
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-card);
  border-radius: 20px;
  padding: 2.25rem 1.5rem;
  text-align: center;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Hover Effects */
.stat-card:hover {
  transform: translateY(-8px);
  border-color: var(--border-hover);
  box-shadow: 0 20px 40px -15px var(--glow-color);
}

/* Subtle Top Accent Glow */
.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 2px;
  background: var(--accent-gradient);
  opacity: 0;
  transition: opacity 0.4s ease;
}

.stat-card:hover::before {
  opacity: 1;
}

/* Stat Number Gradient */
.stat-number {
  font-size: 25px;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 0.5rem;
  
  /* Clear background properties to avoid box overlaps */
  background: transparent !important;
  background-clip: unset !important;
  -webkit-background-clip: unset !important;
  
  /* Apply clean text color */
  color: white !important;
  -webkit-text-fill-color: white !important;
}

/* Stat Label */
.stat-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* Mobile Tweaks */
@media (max-width: 576px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  
  .stat-card {
    padding: 1.5rem 1rem;
    border-radius: 16px;
  }
}

.creativity-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1.5rem;
  max-width: 1100px;
  margin: 0 auto;
}

.creative-widget-card {
  background: rgba(18, 24, 38, 0.75);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  padding: 1.75rem;
  transition: all 0.3s ease;
}

.creative-widget-card:hover {
  border-color: rgba(99, 102, 241, 0.3);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
}

.widget-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #f8fafc;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Services Styling */
.services-group {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.service-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  padding: 0.75rem 1rem;
  transition: all 0.25s ease;
}

.service-item:hover {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(99, 102, 241, 0.35);
  transform: translateX(4px);
}

.service-icon {
  font-size: 1.1rem;
  width: 20px;
  text-align: center;
}

.service-name {
  display: block;
  font-size: 0.92rem;
  font-weight: 600;
  color: #f1f5f9;
}

.service-desc {
  display: block;
  font-size: 0.78rem;
  color: #94a3b8;
}

/* Button Styling */
.btn-view-all {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.75rem;
  background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
  color: #ffffff;
  border-radius: 12px;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.btn-view-all:hover {
  opacity: 0.95;
  color: #ffffff;
  transform: translateY(-2px);
}

/* Stat Icon Styling */
.stat-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto 0.75rem auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: rgba(99, 102, 241, 0.12); /* Subtle accent tint */
  border: 1px solid rgba(99, 102, 241, 0.25);
  color: #818cf8; /* Accent icon color */
  font-size: 1.25rem;
  transition: all 0.3s ease;
}

/* Hover Accent Shift */
.stat-card:hover .stat-icon {
  background: rgba(99, 102, 241, 0.25);
  color: #ffffff;
  transform: scale(1.08);
} 
/*  footer start _____________________________________________________ */
footer {
  background: rgba(15, 23, 42, 0.95);
  backdrop-filter: blur(12px);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding: 4rem 0 2rem 0;
  color: #94a3b8;
  font-family: 'Inter', sans-serif;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  gap: 2.5rem;
  margin-bottom: 3rem;
}

/* Status Pill */
.footer-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(16, 185, 129, 0.1);
  border: 1px solid rgba(16, 185, 129, 0.25);
  color: #10b981;
  padding: 0.35rem 0.8rem;
  border-radius: 20px;
  font-size: 0.8rem;
  font-weight: 500;
  margin-top: 1rem;
}

.status-dot {
  width: 8px;
  height: 8px;
  background-color: #10b981;
  border-radius: 50%;
  box-shadow: 0 0 8px #10b981;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.95); opacity: 0.8; }
  50% { transform: scale(1.1); opacity: 1; }
  100% { transform: scale(0.95); opacity: 0.8; }
}

/* Titles & Navigation */
.footer-title {
  color: #f8fafc;
  font-size: 1.05rem;
  font-weight: 600;
  margin-bottom: 1.25rem;
}

.footer-links {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.footer-links a {
  color: #94a3b8;
  text-decoration: none;
  font-size: 0.9rem;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.footer-links a i {
  font-size: 0.75rem;
  opacity: 0;
  transition: all 0.25s ease;
}

.footer-links a:hover {
  color: #6366f1;
  transform: translateX(4px);
}

.footer-links a:hover i {
  opacity: 1;
}

/* Social Buttons Grid */
.footer-social-grid {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.social-badge {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 0.8rem;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  color: #cbd5e1;
  text-decoration: none;
  font-size: 0.85rem;
  transition: all 0.25s ease;
}

.social-badge:hover {
  background: rgba(99, 102, 241, 0.15);
  border-color: rgba(99, 102, 241, 0.4);
  color: #ffffff;
  transform: translateY(-2px);
}

/* Glowing WhatsApp Button */
.btn-whatsapp-glow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  padding: 0.75rem 1.2rem;
  background: #25d366;
  color: #000000;
  font-weight: 600;
  font-size: 0.88rem;
  border-radius: 12px;
  text-decoration: none;
  box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
  transition: all 0.25s ease;
}

.btn-whatsapp-glow:hover {
  background: #20bd5a;
  color: #000000;
  box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
  transform: translateY(-2px);
}

/* Divider & Bottom Section */
.footer-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
  margin-bottom: 1.5rem;
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 0.85rem;
}

.back-to-top {
  width: 38px;
  height: 38px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  transition: all 0.25s ease;
}

.back-to-top:hover {
  background: #6366f1;
  color: #ffffff;
  transform: translateY(-3px);
}

/* Mobile Responsive */
@media (max-width: 992px) {
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 576px) {
  .footer-grid {
    grid-template-columns: 1fr;
  }
}


/* specially for footer and navbar  */
 /* ==========================================================================
           1. CORE VARIABLES & BASE RESET
           ========================================================================== */
        :root {
            --bg-dark: #08080a;
            --bg-card: rgba(18, 18, 24, 0.75);
            --bg-glass: rgba(12, 12, 15, 0.85);
            --bg-glass-border: rgba(255, 255, 255, 0.08);
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.35);
            --accent: #10b981;
            --accent-glow: rgba(16, 185, 129, 0.35);
            --text-main: #ffffff;
            --text-muted: rgba(255, 255, 255, 0.65);
            --transition-smooth: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-fast: all 0.2s ease;
            --transition-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
            padding-top: 110px;
            padding-bottom: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .container {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* Ambient Glow Tracker */
        .cursor-glow {
            position: fixed;
            top: 0;
            left: 0;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, var(--primary-glow) 0%, rgba(0,0,0,0) 70%);
            border-radius: 50%;
            pointer-events: none;
            transform: translate(-50%, -50%);
            z-index: 0;
            opacity: 0.45;
        }

        /* Main Page Content Wrapper */
        main.container {
            flex: 1;
            width: 100%;
            padding-bottom: 90px;
            position: relative;
            z-index: 1;
        }

        /* ==========================================================================
           2. NAVBAR SECTION
           ========================================================================== */
        .header-nav {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: calc(100% - 48px);
            max-width: 1280px;
            z-index: 1000;
            transition: var(--transition-smooth);
        }

        .nav-glass-panel {
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--bg-glass-border);
            border-radius: 100px;
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 1.1rem;
